From 21ad6b691a4899726eef6637744a8e88dc09075a Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Fri, 20 Nov 2026 20:12:54 +0100
Subject: [PATCH 23/56] WIP: arm64: Galaxy S22 Ultra direct boot from S-Boot

Stop the watchdog, re-enable the DECON trigger and boot with a DTB built
into the image (copied out before the MMU is on). Framebuffer progress
bands in head.S for bring-up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/Kconfig                      | 11 ++++
 arch/arm64/include/asm/kernel-pgtable.h |  7 ++-
 arch/arm64/kernel/Makefile              |  1 +
 arch/arm64/kernel/b0s-direct.S          |  7 +++
 arch/arm64/kernel/head.S                | 79 ++++++++++++++++++++++++-
 arch/arm64/kernel/pi/map_range.c        |  6 ++
 6 files changed, 109 insertions(+), 2 deletions(-)
 create mode 100644 arch/arm64/kernel/b0s-direct.S

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index cab741a69..388c8f1fc 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2516,6 +2516,17 @@ config ARM64_ACPI_PARKING_PROTOCOL
 	  protocol even if the corresponding data is present in the ACPI
 	  MADT table.
 
+config ARM64_B0S_DIRECT_BOOT
+	bool "Galaxy S22 Ultra: boot straight from Samsung S-Boot"
+	help
+	  Boot from S-Boot with no second-stage loader: stop the watchdog
+	  S-Boot leaves running, re-enable the DECON frame trigger and use
+	  the DTB built into the image instead of the one S-Boot passes.
+
+config ARM64_B0S_DTB
+	string "Built-in DTB for S-Boot direct boot"
+	depends on ARM64_B0S_DIRECT_BOOT
+
 config CMDLINE
 	string "Default kernel command string"
 	default ""
diff --git a/arch/arm64/include/asm/kernel-pgtable.h b/arch/arm64/include/asm/kernel-pgtable.h
index 229ee7976..bafa15e61 100644
--- a/arch/arm64/include/asm/kernel-pgtable.h
+++ b/arch/arm64/include/asm/kernel-pgtable.h
@@ -59,7 +59,12 @@
 				    + EARLY_SEGMENT_EXTRA_PAGES))
 
 #define INIT_IDMAP_DIR_PAGES	(EARLY_PAGES(INIT_IDMAP_PGTABLE_LEVELS, KIMAGE_VADDR, kimage_limit, 1))
-#define INIT_IDMAP_DIR_SIZE	((INIT_IDMAP_DIR_PAGES + EARLY_IDMAP_EXTRA_PAGES) * PAGE_SIZE)
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+#define B0S_IDMAP_FB_PAGES	2	/* boot framebuffer, 2M blocks */
+#else
+#define B0S_IDMAP_FB_PAGES	0
+#endif
+#define INIT_IDMAP_DIR_SIZE	((INIT_IDMAP_DIR_PAGES + EARLY_IDMAP_EXTRA_PAGES + B0S_IDMAP_FB_PAGES) * PAGE_SIZE)
 
 #define INIT_IDMAP_FDT_PAGES	(EARLY_PAGES(INIT_IDMAP_PGTABLE_LEVELS, 0UL, UL(MAX_FDT_SIZE), 1) - 1)
 #define INIT_IDMAP_FDT_SIZE	((INIT_IDMAP_FDT_PAGES + EARLY_IDMAP_EXTRA_FDT_PAGES) * PAGE_SIZE)
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index ea6633943..14f255643 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -39,6 +39,7 @@ obj-y			:= debug-monitors.o entry.o irq.o fpsimd.o		\
 			   syscall.o proton-pack.o idle.o patching.o pi/	\
 			   rsi.o jump_label.o
 
+obj-$(CONFIG_ARM64_B0S_DIRECT_BOOT)	+= b0s-direct.o
 obj-$(CONFIG_COMPAT)			+= sys32.o signal32.o			\
 					   sys_compat.o
 obj-$(CONFIG_COMPAT)			+= sigreturn32.o
diff --git a/arch/arm64/kernel/b0s-direct.S b/arch/arm64/kernel/b0s-direct.S
new file mode 100644
index 000000000..eb6de0bfa
--- /dev/null
+++ b/arch/arm64/kernel/b0s-direct.S
@@ -0,0 +1,7 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/* DTB for booting the Galaxy S22 Ultra straight from S-Boot (see head.S). */
+	.section .rodata, "a"
+	.balign	4096
+	.globl	__b0s_dtb
+__b0s_dtb:
+	.incbin	CONFIG_ARM64_B0S_DTB
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87a822e5c..017aec287 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -82,9 +82,49 @@
 	 *  x20        primary_entry() .. __primary_switch()    CPU boot mode
 	 *  x21        primary_entry() .. start_kernel()        FDT pointer passed at boot in x0
 	 */
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+	/* b0s direct boot progress: paint fb lines [300 * n, 300 * (n + 1)) */
+	.macro	b0s_band, n, color
+	mov_q	x4, (0xf6200000 + \n * 300 * 1440 * 4)
+	mov_q	x6, (1440 * 300)
+	mov_q	x5, \color
+9999:	str	w5, [x4], #4
+	subs	x6, x6, #1
+	b.ne	9999b
+	dsb	sy
+	.endm
+#else
+	.macro	b0s_band, n, color
+	.endm
+#endif
+
 SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
 	bl	preserve_boot_args
+	b0s_band 1, 0xff00ff00
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+	/*
+	 * Ignore S-Boot's DTB, use ours. Copy it out of the image first:
+	 * map_fdt() maps 2 MiB from the FDT into the init idmap and cannot
+	 * split the block mappings that already cover the kernel.
+	 */
+	adr_l	x4, __b0s_dtb
+	ldr	w6, [x4, #4]			// totalsize, big endian
+	rev	w6, w6
+	add	x6, x6, #7
+	lsr	x6, x6, #3
+	mov_q	x21, 0xa0000000
+	mov	x7, x21
+2:	ldr	x5, [x4], #8
+	str	x5, [x7], #8
+	subs	x6, x6, #1
+	b.ne	2b
+	dsb	sy
+	mov	x0, x21				// drop stale lines over the copy
+	mov	x1, x7
+	adr_l	x2, dcache_inval_poc
+	blr	x2
+#endif
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -116,7 +156,8 @@ SYM_CODE_START(primary_entry)
 	adr_l	x2, dcache_clean_poc
 	blr	x2
 
-1:	mov	x0, x19
+1:	b0s_band 2, 0xff0000ff
+	mov	x0, x19
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
 
@@ -127,6 +168,20 @@ SYM_CODE_START(primary_entry)
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+	b0s_band 3, 0xffffff00
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+	/* does EL2 stage 2 block writes to S-Boot's "kernel text"? */
+	adr_l	x4, __b0s_dtb			// .rodata
+	ldr	w5, [x4]
+	str	w5, [x4]
+	dsb	sy
+	b0s_band 4, 0xffff00ff
+	adr_l	x4, _stext			// .text
+	ldr	w5, [x4]
+	str	w5, [x4]
+	dsb	sy
+	b0s_band 5, 0xff00ffff
+#endif
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
@@ -169,6 +224,25 @@ SYM_CODE_END(record_mmu_state)
  */
 SYM_CODE_START_LOCAL(preserve_boot_args)
 	mov	x21, x0				// x21=FDT
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+	/* S-Boot leaves the CL0 watchdog armed: drop nWDTRESET, stop it */
+	mov_q	x4, 0x15861244			// PMU CLUSTER0_NONCPU_INT_EN
+	ldr	w5, [x4]
+	bic	w5, w5, #(1 << 2)
+	str	w5, [x4]
+	mov_q	x4, 0x10050000			// WTCON
+	ldr	w5, [x4]
+	bic	w5, w5, #(1 << 5)		// ENABLE
+	bic	w5, w5, #(1 << 0)		// RSTEN
+	str	w5, [x4]
+	mov	w5, #1
+	str	w5, [x4, #0xc]			// WTCLRINT
+	/* DECON0 HW_SW_TRIG_CONTROL: keep the boot framebuffer updating */
+	mov_q	x4, 0x19f00030
+	mov	w5, #0x1281
+	str	w5, [x4]
+	b0s_band 0, 0xffff0000
+#endif
 
 	adr_l	x0, boot_args			// record the contents of
 	stp	x21, x1, [x0]			// x0 .. x3 at kernel entry
@@ -243,6 +317,7 @@ SYM_FUNC_START_LOCAL(__primary_switched)
 	mov	x0, x20
 	bl	finalise_el2			// Prefer VHE if possible
 	ldp	x29, x30, [sp], #16
+	b0s_band 8, 0xff808080
 	bl	start_kernel
 	ASM_BUG()
 SYM_FUNC_END(__primary_switched)
@@ -509,6 +584,7 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 	adrp	x1, reserved_pg_dir
 	adrp	x2, __pi_init_idmap_pg_dir
 	bl	__enable_mmu
+	b0s_band 6, 0xffffffff
 
 	adrp	x1, early_init_stack
 	mov	sp, x1
@@ -516,6 +592,7 @@ SYM_FUNC_START_LOCAL(__primary_switch)
 	mov	x0, x20				// pass the full boot status
 	mov	x1, x21				// pass the FDT
 	bl	__pi_early_map_kernel		// Map and relocate the kernel
+	b0s_band 7, 0xffff8000
 
 	ldr	x8, =__primary_switched
 	adrp	x0, KERNEL_START		// __pa(KERNEL_START)
diff --git a/arch/arm64/kernel/pi/map_range.c b/arch/arm64/kernel/pi/map_range.c
index 761b14893..7e7b31aa6 100644
--- a/arch/arm64/kernel/pi/map_range.c
+++ b/arch/arm64/kernel/pi/map_range.c
@@ -104,6 +104,12 @@ asmlinkage phys_addr_t __init create_init_idmap(pgd_t *pg_dir, ptval_t clrmask)
 	map_range(&ptep, (u64)__initdata_begin, (u64)_end,
 		  (phys_addr_t)__initdata_begin, data_prot, IDMAP_ROOT_LEVEL,
 		  (pte_t *)pg_dir, false, 0);
+#ifdef CONFIG_ARM64_B0S_DIRECT_BOOT
+	/* boot framebuffer, for head.S progress bands after the MMU is on */
+	map_range(&ptep, 0xf6200000, 0xf7400000, 0xf6200000,
+		  __pgprot(PROT_DEVICE_nGnRE), IDMAP_ROOT_LEVEL,
+		  (pte_t *)pg_dir, false, 0);
+#endif
 
 	return ptep;
 }
-- 
2.56.1

