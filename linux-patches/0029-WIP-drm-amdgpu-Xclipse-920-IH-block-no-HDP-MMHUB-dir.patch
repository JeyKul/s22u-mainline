diff --git a/drivers/gpu/drm/amd/amdgpu/xclipse920_ih.c b/drivers/gpu/drm/amd/amdgpu/xclipse920_ih.c
new file mode 100644
index 000000000..ea3efa2f0
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/xclipse920_ih.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Samsung Xclipse 920 interrupt handler: the GC's own "gIH" ring (GC 10.4),
+ * in place of OSSSYS IH. Based on Samsung's vangogh_lite_ih.c (sgpu).
+ * No doorbell, no wptr write-back (gIH erratum), ring in system RAM by bus
+ * address. The ring's interrupt is the GPU's SPI, delivered as INTx by the
+ * PCI shim.
+ */
+#include "amdgpu.h"
+#include "amdgpu_ih.h"
+#include "nv.h"
+#include "soc15_common.h"
+
+/* GC 10.4 gIH registers (gc_10_4_0_offset.h / _sh_mask.h), GC segment 1 */
+#define mmGIH_RB_CNTL					0x2f40
+#define mmGIH_RB_CNTL_BASE_IDX				1
+#define mmGIH_RB_BASE					0x2f41
+#define mmGIH_RB_BASE_BASE_IDX				1
+#define mmGIH_RB_RPTR					0x2f43
+#define mmGIH_RB_RPTR_BASE_IDX				1
+#define mmGIH_RB_WPTR					0x2f44
+#define mmGIH_RB_WPTR_BASE_IDX				1
+#define mmGIH_VERSION					0x2f65
+#define mmGIH_VERSION_BASE_IDX				1
+#define mmGIH_STATUS					0x2f67
+#define mmGIH_STATUS_BASE_IDX				1
+
+#define GIH_RB_CNTL__RB_ENABLE__SHIFT			0x0
+#define GIH_RB_CNTL__RB_SIZE__SHIFT			0x1
+#define GIH_RB_CNTL__WPTR_WRITEBACK_ENABLE__SHIFT	0x8
+#define GIH_RB_CNTL__WPTR_OVERFLOW_ENABLE__SHIFT	0x10
+#define GIH_RB_CNTL__ENABLE_INTR__SHIFT			0x11
+#define GIH_RB_CNTL__WPTR_OVERFLOW_CLEAR__SHIFT		0x1f
+#define GIH_RB_CNTL__RB_ENABLE_MASK			0x00000001L
+#define GIH_RB_CNTL__RB_SIZE_MASK			0x0000003EL
+#define GIH_RB_CNTL__WPTR_WRITEBACK_ENABLE_MASK		0x00000100L
+#define GIH_RB_CNTL__WPTR_OVERFLOW_ENABLE_MASK		0x00010000L
+#define GIH_RB_CNTL__ENABLE_INTR_MASK			0x00020000L
+#define GIH_RB_CNTL__WPTR_OVERFLOW_CLEAR_MASK		0x80000000L
+#define GIH_RB_WPTR__RB_OVERFLOW__SHIFT			0x0
+#define GIH_RB_WPTR__RB_OVERFLOW_MASK			0x00000001L
+
+#define XCLIPSE920_IH_RING_SIZE	(4 * 1024)
+
+static void xclipse920_ih_enable_interrupts(struct amdgpu_device *adev, bool enable)
+{
+	u32 cntl = RREG32_SOC15(GC, 0, mmGIH_RB_CNTL);
+
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, RB_ENABLE, enable);
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, ENABLE_INTR, enable);
+	WREG32_SOC15(GC, 0, mmGIH_RB_CNTL, cntl);
+	if (!enable) {
+		WREG32_SOC15(GC, 0, mmGIH_RB_RPTR, 0);
+		WREG32_SOC15(GC, 0, mmGIH_RB_WPTR, 0);
+		adev->irq.ih.rptr = 0;
+	}
+	adev->irq.ih.enabled = enable;
+}
+
+static int xclipse920_ih_irq_init(struct amdgpu_device *adev)
+{
+	struct amdgpu_ih_ring *ih = &adev->irq.ih;
+	u32 cntl;
+
+	xclipse920_ih_enable_interrupts(adev, false);
+
+	adev->nbio.funcs->ih_control(adev);
+
+	/* [39:8] of the ring's bus address */
+	WREG32_SOC15(GC, 0, mmGIH_RB_BASE, ih->gpu_addr >> 8);
+
+	cntl = RREG32_SOC15(GC, 0, mmGIH_RB_CNTL);
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, WPTR_OVERFLOW_CLEAR, 1);
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, WPTR_OVERFLOW_ENABLE, 1);
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, RB_SIZE, order_base_2(ih->ring_size / 4));
+	cntl = REG_SET_FIELD(cntl, GIH_RB_CNTL, WPTR_WRITEBACK_ENABLE, 0);
+	WREG32_SOC15(GC, 0, mmGIH_RB_CNTL, cntl);
+
+	WREG32_SOC15(GC, 0, mmGIH_RB_RPTR, 0);
+	WREG32_SOC15(GC, 0, mmGIH_RB_WPTR, 0);
+
+	pci_set_master(adev->pdev);
+
+	xclipse920_ih_enable_interrupts(adev, true);
+
+	dev_info(adev->dev, "gIH: version %08x status %08x ring 0x%llx\n",
+		 RREG32_SOC15(GC, 0, mmGIH_VERSION), RREG32_SOC15(GC, 0, mmGIH_STATUS),
+		 ih->gpu_addr);
+	return 0;
+}
+
+static u32 xclipse920_ih_get_wptr(struct amdgpu_device *adev, struct amdgpu_ih_ring *ih)
+{
+	u32 wptr, tmp;
+
+	wptr = RREG32_SOC15(GC, 0, mmGIH_RB_WPTR);
+	if (!REG_GET_FIELD(wptr, GIH_RB_WPTR, RB_OVERFLOW))
+		goto out;
+
+	wptr = REG_SET_FIELD(wptr, GIH_RB_WPTR, RB_OVERFLOW, 0);
+	/* resume from the oldest vector not yet overwritten */
+	tmp = (wptr + 32) & ih->ptr_mask;
+	dev_warn(adev->dev, "IH ring buffer overflow (0x%08X, 0x%08X, 0x%08X)\n",
+		 wptr, ih->rptr, tmp);
+	ih->rptr = tmp;
+
+	tmp = RREG32_SOC15(GC, 0, mmGIH_RB_CNTL);
+	tmp = REG_SET_FIELD(tmp, GIH_RB_CNTL, WPTR_OVERFLOW_CLEAR, 1);
+	WREG32_SOC15(GC, 0, mmGIH_RB_CNTL, tmp);
+out:
+	return wptr & ih->ptr_mask;
+}
+
+static void xclipse920_ih_decode_iv(struct amdgpu_device *adev,
+				    struct amdgpu_ih_ring *ih,
+				    struct amdgpu_iv_entry *entry)
+{
+	amdgpu_ih_decode_iv_helper(adev, ih, entry);
+	/* only GFXHUB exists */
+	entry->vmid_src = 0;
+}
+
+static void xclipse920_ih_set_rptr(struct amdgpu_device *adev, struct amdgpu_ih_ring *ih)
+{
+	WREG32_SOC15(GC, 0, mmGIH_RB_RPTR, ih->rptr);
+}
+
+static const struct amdgpu_ih_funcs xclipse920_ih_funcs = {
+	.get_wptr = xclipse920_ih_get_wptr,
+	.decode_iv = xclipse920_ih_decode_iv,
+	.decode_iv_ts = amdgpu_ih_decode_iv_ts_helper,
+	.set_rptr = xclipse920_ih_set_rptr,
+};
+
+static int xclipse920_ih_early_init(struct amdgpu_ip_block *ip_block)
+{
+	ip_block->adev->irq.ih_funcs = &xclipse920_ih_funcs;
+	return 0;
+}
+
+static int xclipse920_ih_sw_init(struct amdgpu_ip_block *ip_block)
+{
+	struct amdgpu_device *adev = ip_block->adev;
+	int r;
+
+	/* gIH takes bus addresses, no doorbell */
+	r = amdgpu_ih_ring_init(adev, &adev->irq.ih, XCLIPSE920_IH_RING_SIZE, true);
+	if (r)
+		return r;
+	adev->irq.ih.use_doorbell = false;
+	adev->irq.ih1.ring_size = 0;
+	adev->irq.ih2.ring_size = 0;
+
+	return amdgpu_irq_init(adev);
+}
+
+static int xclipse920_ih_sw_fini(struct amdgpu_ip_block *ip_block)
+{
+	amdgpu_irq_fini_sw(ip_block->adev);
+	return 0;
+}
+
+static int xclipse920_ih_hw_init(struct amdgpu_ip_block *ip_block)
+{
+	return xclipse920_ih_irq_init(ip_block->adev);
+}
+
+static int xclipse920_ih_hw_fini(struct amdgpu_ip_block *ip_block)
+{
+	xclipse920_ih_enable_interrupts(ip_block->adev, false);
+	mdelay(1);
+	return 0;
+}
+
+static int xclipse920_ih_suspend(struct amdgpu_ip_block *ip_block)
+{
+	return xclipse920_ih_hw_fini(ip_block);
+}
+
+static int xclipse920_ih_resume(struct amdgpu_ip_block *ip_block)
+{
+	return xclipse920_ih_hw_init(ip_block);
+}
+
+static bool xclipse920_ih_is_idle(struct amdgpu_ip_block *ip_block)
+{
+	return true;
+}
+
+static int xclipse920_ih_wait_for_idle(struct amdgpu_ip_block *ip_block)
+{
+	return 0;
+}
+
+static int xclipse920_ih_set_clockgating_state(struct amdgpu_ip_block *ip_block,
+					       enum amd_clockgating_state state)
+{
+	return 0;
+}
+
+static int xclipse920_ih_set_powergating_state(struct amdgpu_ip_block *ip_block,
+					       enum amd_powergating_state state)
+{
+	return 0;
+}
+
+static const struct amd_ip_funcs xclipse920_ih_ip_funcs = {
+	.name = "xclipse920_ih",
+	.early_init = xclipse920_ih_early_init,
+	.sw_init = xclipse920_ih_sw_init,
+	.sw_fini = xclipse920_ih_sw_fini,
+	.hw_init = xclipse920_ih_hw_init,
+	.hw_fini = xclipse920_ih_hw_fini,
+	.suspend = xclipse920_ih_suspend,
+	.resume = xclipse920_ih_resume,
+	.is_idle = xclipse920_ih_is_idle,
+	.wait_for_idle = xclipse920_ih_wait_for_idle,
+	.set_clockgating_state = xclipse920_ih_set_clockgating_state,
+	.set_powergating_state = xclipse920_ih_set_powergating_state,
+};
+
+const struct amdgpu_ip_block_version xclipse920_ih_ip_block = {
+	.type = AMD_IP_BLOCK_TYPE_IH,
+	.major = 1,
+	.minor = 0,
+	.rev = 0,
+	.funcs = &xclipse920_ih_ip_funcs,
+};
