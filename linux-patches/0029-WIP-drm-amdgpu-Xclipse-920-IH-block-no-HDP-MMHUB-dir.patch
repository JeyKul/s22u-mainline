 static u64 xclipse920_mmhub_get_fb_location(struct amdgpu_device *adev)
 {
 	return XCLIPSE920_FB_BASE;
@@ -120,6 +145,7 @@ int xclipse920_set_ip_blocks(struct amdgpu_device *adev)
 	xclipse920_nbio_funcs.get_memsize = xclipse920_get_memsize;
 	adev->nbio.funcs = &xclipse920_nbio_funcs;
 	adev->nbio.hdp_flush_reg = &nbio_v2_3_hdp_flush_reg;
+	adev->hdp.funcs = &xclipse920_hdp_funcs;
 
 	/* FB aperture over the carve-out and the TMR, MC == physical */
 	WREG32_SOC15(GC, 0, mmGCMC_VM_FB_LOCATION_BASE, XCLIPSE920_FB_BASE >> 24);
@@ -128,5 +154,6 @@ int xclipse920_set_ip_blocks(struct amdgpu_device *adev)
 
 	amdgpu_device_ip_block_add(adev, &nv_common_ip_block);
 	amdgpu_device_ip_block_add(adev, &gmc_v10_0_ip_block);
+	amdgpu_device_ip_block_add(adev, &xclipse920_ih_ip_block);
