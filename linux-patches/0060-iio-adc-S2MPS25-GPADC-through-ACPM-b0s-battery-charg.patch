@@ -51,10 +51,16 @@ struct acpm_tmu_ops {
 	int (*resume)(struct acpm_handle *handle, unsigned int acpm_chan_id);
 };
 
+struct acpm_gpadc_ops {
+	int (*read)(struct acpm_handle *handle, unsigned int acpm_chan_id,
+		    u8 pmic, u8 chan, u16 *raw);
+};
+
 struct acpm_ops {
 	struct acpm_dvfs_ops dvfs;
 	struct acpm_pmic_ops pmic;
 	struct acpm_tmu_ops tmu;
+	struct acpm_gpadc_ops gpadc;
 };
 
