diff --git a/drivers/iio/adc/s2mps25-gpadc.c b/drivers/iio/adc/s2mps25-gpadc.c
new file mode 100644
index 000000000..a9637694c
--- /dev/null
+++ b/drivers/iio/adc/s2mps25-gpadc.c
@@ -0,0 +1,107 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S2MPS25 general purpose ADC, read through the ACPM firmware (the PMIC
+ * sits behind APM's SPMI): 15 raw 12-bit channels, mostly NTC thermistors
+ * (battery, charger, USB connector, ...), converted by generic-adc-thermal.
+ */
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/iio/iio.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define S2MPS25_GPADC_CHANNELS	15
+
+struct s2mps25_gpadc {
+	struct acpm_handle *acpm;
+	u32 acpm_chan;
+	struct mutex lock;
+};
+
+static int s2mps25_gpadc_read_raw(struct iio_dev *indio_dev, struct iio_chan_spec const *chan,
+				  int *val, int *val2, long mask)
+{
+	struct s2mps25_gpadc *adc = iio_priv(indio_dev);
+	u16 raw;
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_RAW)
+		return -EINVAL;
+	mutex_lock(&adc->lock);
+	ret = adc->acpm->ops->gpadc.read(adc->acpm, adc->acpm_chan, 0, chan->channel, &raw);
+	mutex_unlock(&adc->lock);
+	if (ret)
+		return ret;
+	*val = raw;
+	return IIO_VAL_INT;
+}
+
+static const struct iio_info s2mps25_gpadc_info = {
+	.read_raw = s2mps25_gpadc_read_raw,
+};
+
+#define S2MPS25_GPADC_CHANNEL(n) {				\
+	.type = IIO_VOLTAGE,					\
+	.indexed = 1,						\
+	.channel = n,						\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),		\
+	.datasheet_name = "adc" #n,				\
+}
+
+static const struct iio_chan_spec s2mps25_gpadc_channels[] = {
+	S2MPS25_GPADC_CHANNEL(0), S2MPS25_GPADC_CHANNEL(1), S2MPS25_GPADC_CHANNEL(2),
+	S2MPS25_GPADC_CHANNEL(3), S2MPS25_GPADC_CHANNEL(4), S2MPS25_GPADC_CHANNEL(5),
+	S2MPS25_GPADC_CHANNEL(6), S2MPS25_GPADC_CHANNEL(7), S2MPS25_GPADC_CHANNEL(8),
+	S2MPS25_GPADC_CHANNEL(9), S2MPS25_GPADC_CHANNEL(10), S2MPS25_GPADC_CHANNEL(11),
+	S2MPS25_GPADC_CHANNEL(12), S2MPS25_GPADC_CHANNEL(13), S2MPS25_GPADC_CHANNEL(14),
+};
+
+static int s2mps25_gpadc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct s2mps25_gpadc *adc;
+	struct iio_dev *indio_dev;
+	int ret;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*adc));
+	if (!indio_dev)
+		return -ENOMEM;
+	adc = iio_priv(indio_dev);
+	adc->acpm = devm_acpm_get_by_phandle(dev);
+	if (IS_ERR(adc->acpm))
+		return dev_err_probe(dev, PTR_ERR(adc->acpm), "no ACPM\n");
+	if (!adc->acpm->ops->gpadc.read)
+		return -ENODEV;
+	ret = of_property_read_u32(dev->of_node, "samsung,acpm-channel", &adc->acpm_chan);
+	if (ret)
+		return dev_err_probe(dev, ret, "no samsung,acpm-channel\n");
+	ret = devm_mutex_init(dev, &adc->lock);
+	if (ret)
+		return ret;
+
+	indio_dev->name = "s2mps25-gpadc";
+	indio_dev->info = &s2mps25_gpadc_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = s2mps25_gpadc_channels;
+	indio_dev->num_channels = ARRAY_SIZE(s2mps25_gpadc_channels);
+	return devm_iio_device_register(dev, indio_dev);
+}
+
+static const struct of_device_id s2mps25_gpadc_of_match[] = {
+	{ .compatible = "samsung,s2mps25-gpadc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mps25_gpadc_of_match);
+
+static struct platform_driver s2mps25_gpadc_driver = {
+	.probe = s2mps25_gpadc_probe,
+	.driver = {
+		.name = "s2mps25-gpadc",
+		.of_match_table = s2mps25_gpadc_of_match,
+	},
+};
+module_platform_driver(s2mps25_gpadc_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPS25 GPADC through ACPM");
+MODULE_LICENSE("GPL");
diff --git a/include/linux/firmware/samsung/exynos-acpm-protocol.h b/include/linux/firmware/samsung/exynos-acpm-protocol.h
