diff --git a/drivers/firmware/samsung/exynos-acpm-gpadc.c b/drivers/firmware/samsung/exynos-acpm-gpadc.c
new file mode 100644
index 000000000..197d34502
--- /dev/null
+++ b/drivers/firmware/samsung/exynos-acpm-gpadc.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * PMIC general purpose ADC (thermistors) through ACPM, as Samsung's s2mps25-adc
+ * driver reads it: cmd[1] = (sub PMIC << 24) | channel, the reply's cmd[1]
+ * holds the 12-bit result in its low 16 bits (0xfffd-0xffff: failure).
+ */
+#include <linux/array_size.h>
+#include <linux/errno.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/types.h>
+
+#include "exynos-acpm.h"
+#include "exynos-acpm-gpadc.h"
+
+int acpm_gpadc_read(struct acpm_handle *handle, unsigned int acpm_chan_id,
+		    u8 pmic, u8 chan, u16 *raw)
+{
+	u32 cmd[2] = { 0, ((u32)(pmic & 0xf) << 24) | chan };	/* channel 11 takes 8 bytes */
+	struct acpm_xfer xfer;
+	int ret;
+
+	acpm_set_xfer(&xfer, cmd, ARRAY_SIZE(cmd), acpm_chan_id, true);
+	ret = acpm_do_xfer(handle, &xfer);
+	if (ret)
+		return ret;
+	if ((cmd[1] & 0xffff) >= 0xfffd)
+		return -EIO;
+	*raw = cmd[1] & 0xffff;
+	return 0;
+}
