From 41201dbfd31ece9a8d4c91f3289920cac8e10a15 Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Fri, 20 Nov 2026 13:22:28 +0100
Subject: [PATCH 04/60] efi/earlycon: support plain framebuffers and a
 no-scroll mode

screen_info_fb=<base>,<width>,<height> describes a 32 bpp framebuffer
left running by a non-EFI bootloader, so earlycon=efifb can print on it
from the first line of start_kernel. screen_info is cleared again
before sysfb runs, leaving the DT simple-framebuffer as the only
framebuffer device.

earlycon=efifb,wrap restarts at the top instead of scrolling. Scrolling
copies every scanline through an uncached mapping for each new line,
which takes seconds per line on a 1440x3088 panel.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/firmware/efi/earlycon.c | 68 ++++++++++++++++++++++++++++++++-
 1 file changed, 66 insertions(+), 2 deletions(-)

diff --git a/drivers/firmware/efi/earlycon.c b/drivers/firmware/efi/earlycon.c
index 3d060d599..96f2052df 100644
--- a/drivers/firmware/efi/earlycon.c
+++ b/drivers/firmware/efi/earlycon.c
@@ -21,6 +21,7 @@ static u32 efi_x_array[1024];
 static u32 efi_x, efi_y;
 static u64 fb_base;
 static bool fb_wb;
+static bool fb_wrap;
 static void *efi_fb;
 
 /*
@@ -53,6 +54,54 @@ static int __init efi_earlycon_unmap_fb(void)
 }
 late_initcall(efi_earlycon_unmap_fb);
 
+/*
+ * "screen_info_fb=<base>,<width>,<height>": describe a firmware framebuffer
+ * (32 bpp, xRGB) for non-EFI boots, so that earlycon=efifb can draw on it.
+ * Must come before earlycon= on the command line. screen_info is cleared
+ * again before sysfb runs, so the DT simple-framebuffer stays the only
+ * framebuffer device.
+ */
+static bool screen_info_fb_set __initdata;
+
+static int __init screen_info_fb_param(char *arg)
+{
+	struct screen_info *si = &sysfb_primary_display.screen;
+	unsigned long long base;
+	unsigned int w, h;
+
+	if (!arg || sscanf(arg, "%llx,%u,%u", &base, &w, &h) != 3)
+		return -EINVAL;
+
+	si->orig_video_isVGA = VIDEO_TYPE_EFI;
+	si->lfb_base = lower_32_bits(base);
+	si->ext_lfb_base = upper_32_bits(base);
+	si->capabilities |= VIDEO_CAPABILITY_64BIT_BASE;
+	si->lfb_width = w;
+	si->lfb_height = h;
+	si->lfb_depth = 32;
+	si->lfb_linelength = w * 4;
+	si->lfb_size = w * 4 * h;
+	si->red_size = 8;
+	si->red_pos = 16;
+	si->green_size = 8;
+	si->green_pos = 8;
+	si->blue_size = 8;
+	si->blue_pos = 0;
+	si->rsvd_size = 8;
+	si->rsvd_pos = 24;
+	screen_info_fb_set = true;
+	return 0;
+}
+early_param("screen_info_fb", screen_info_fb_param);
+
+static int __init screen_info_fb_clear(void)
+{
+	if (screen_info_fb_set)
+		sysfb_primary_display.screen.orig_video_isVGA = 0;
+	return 0;
+}
+subsys_initcall(screen_info_fb_clear);
+
 static __ref void *efi_earlycon_map(unsigned long start, unsigned long len)
 {
 	pgprot_t fb_prot;
@@ -201,6 +250,17 @@ efi_earlycon_write(struct console *con, const char *str, unsigned int num)
 			efi_y += font->height;
 		}
 
+		if (fb_wrap && efi_x == 0) {
+			u32 i;
+
+			/* wrap mode: no scrolling, restart at the top */
+			if (efi_y + font->height > si->lfb_height)
+				efi_y = 0;
+			for (i = 0; i < font->height; i++)
+				efi_earlycon_clear_scanline(efi_y + i, si);
+			continue;
+		}
+
 		if (efi_y + font->height > si->lfb_height) {
 			u32 i;
 
@@ -232,6 +292,7 @@ static int __init efi_earlycon_setup(struct earlycon_device *device,
 	u32 i;
 
 	fb_wb = opt && !strcmp(opt, "ram");
+	fb_wrap = opt && !strcmp(opt, "wrap");
 
 	if (si->orig_video_isVGA != VIDEO_TYPE_EFI) {
 		fb_probed = true;
@@ -265,8 +326,11 @@ static int __init efi_earlycon_setup(struct earlycon_device *device,
 	cur_line_y = 0;
 
 	efi_y -= font->height;
-	for (i = 0; i < (yres - efi_y) / font->height; i++)
-		efi_earlycon_scroll_up(si);
+	if (fb_wrap)
+		efi_y = 0;
+	else
+		for (i = 0; i < (yres - efi_y) / font->height; i++)
+			efi_earlycon_scroll_up(si);
 
 	device->con->write = efi_earlycon_write;
 	earlycon_console = device->con;
-- 
