From f1d650219067d7190ce52d559dcb765eddd42565 Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Fri, 20 Nov 2026 13:36:20 +0100
Subject: [PATCH 05/34] arm64: dts: exynos2200-b0s: enable UFS

The UFS PHY and host as on the stock tree (hci, vs_hci, unipro, ufsp,
PMA; SPI 553). The link comes up at HS-G4, two lanes, and reads match
the stock partitions byte for byte.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos2200-b0s.dts | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
index ae9376363..ab1e23b05 100644
--- a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
+++ b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
@@ -220,6 +220,34 @@ el2-earlymem@afe600000 {
 	};
 };
 
+&{/soc@0} {
+	ufs_phy: phy@11104000 {
+		compatible = "samsung,exynos2200-ufs-phy";
+		reg = <0x11104000 0x4000>;
+		reg-names = "phy-pma";
+		samsung,pmu-syscon = <&pmu_system_controller>;
+		#phy-cells = <0>;
+	};
+
+	ufs: ufs@11100000 {
+		compatible = "samsung,exynos2200-ufs";
+		reg = <0x11100000 0x200>,
+		      <0x11101100 0x200>,
+		      <0x11180000 0x8000>,
+		      <0x111a0000 0xa014>;
+		reg-names = "hci", "vs_hci", "unipro", "ufsp";
+		interrupts = <GIC_SPI 553 IRQ_TYPE_LEVEL_HIGH 0>;
+		clocks = <&cmu_ufs CLK_MOUT_UFS_NOC_USER>,
+			 <&cmu_ufs CLK_MOUT_UFS_UFS_EMBD_USER>;
+		clock-names = "core_clk", "sclk_unipro_main";
+		freq-table-hz = <0 0>, <0 0>;
+		phys = <&ufs_phy>;
+		phy-names = "ufs-phy";
+		samsung,sysreg = <&syscon_ufs 0x700>;
+		dma-coherent;
+	};
+};
+
 &cmu_hsi0 {
 	clocks = <&xtcxo>,
 		 <&rtcclk>,
-- 
