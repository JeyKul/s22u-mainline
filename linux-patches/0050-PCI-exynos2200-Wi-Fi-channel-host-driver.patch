 drivers/pci/controller/dwc/Makefile           |   1 +
 .../pci/controller/dwc/pcie-designware-host.c |   1 +
 drivers/pci/controller/dwc/pcie-exynos2200.c  | 385 ++++++++++++++++++
 4 files changed, 396 insertions(+)
 create mode 100644 drivers/pci/controller/dwc/pcie-exynos2200.c

