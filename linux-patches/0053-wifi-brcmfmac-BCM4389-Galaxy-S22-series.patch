 	brcmf_set_join_pref(ifp, &sme->bss_select);
 
-	err  = brcmf_fil_bsscfg_data_set(ifp, "join", ext_join_params,
-					 join_params_size);
+	if (ifp->drvr->bus_if->chip == BRCM_CC_4389_CHIP_ID) {
+		/*
+		 * Newer firmware (BCM4389) takes only the versioned layout
+		 * (wl_extjoin_params_v1): a version word in front, and an assoc
+		 * part with its own version, flags and a BSSID count.
+		 */
+		struct brcmf_assoc_params_le *a = &ext_join_params->assoc_le;
+		u8 v1[80] = {};
+
+		v1[0] = 1;					/* version */
+		memcpy(&v1[4], &ext_join_params->ssid_le, 36);
+		v1[40] = ext_join_params->scan_le.scan_type;
+		memcpy(&v1[44], &ext_join_params->scan_le.nprobes, 4);
+		memcpy(&v1[48], &ext_join_params->scan_le.active_time, 4);
+		memcpy(&v1[52], &ext_join_params->scan_le.passive_time, 4);
+		memcpy(&v1[56], &ext_join_params->scan_le.home_time, 4);
+		v1[60] = 1;					/* assoc version */
+		memcpy(&v1[64], a->bssid, ETH_ALEN);
+		memcpy(&v1[72], &a->chanspec_num, 4);
+		memcpy(&v1[76], &a->chanspec_list[0], 2);
+		err = brcmf_fil_bsscfg_data_set(ifp, "join", v1,
+						cfg->channel ? 78 : 76);
+	} else {
+		err = brcmf_fil_bsscfg_data_set(ifp, "join", ext_join_params,
+						join_params_size);
+	}
 	kfree(ext_join_params);
 	if (!err)
 		/* This is it. join command worked, we are done */
