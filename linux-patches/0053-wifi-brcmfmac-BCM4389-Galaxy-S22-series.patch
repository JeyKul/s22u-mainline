+	if (sysmem->pub.rev < 12) {
+		nrb = (coreinfo & 0x3e0) >> 5;
+		nb = coreinfo & 0x1f;
+	} else {
+		nrb = (coreinfo >> 24) & 0xff;
+		nb = (coreinfo >> 16) & 0xff;
+	}
 
