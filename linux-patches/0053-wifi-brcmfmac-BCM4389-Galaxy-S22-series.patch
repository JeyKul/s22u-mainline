+/*
+ * BAR1 shows tcm_size bytes of the backplane, starting at the window in config register 0x84.
+ * Chips whose RAM does not fit one window (BCM4389: RAM at 0x200000, more than 2 MB of it) need
+ * the window moved, as Broadcom's DHD does. Callers hold tcm_lock.
+ */
+static void __iomem *
+brcmf_pcie_tcm(struct brcmf_pciedev_info *devinfo, u32 addr, u32 *avail)
+{
+	u32 win = addr & ~(devinfo->tcm_size - 1);
+
+	if (win != devinfo->tcm_win) {
+		pci_write_config_dword(devinfo->pdev, BRCMF_PCIE_BAR1_WINDOW, win);
+		devinfo->tcm_win = win;
+	}
+	if (avail)
+		*avail = devinfo->tcm_size - (addr - win);
+	return devinfo->tcm + (addr - win);
+}
+
+#define BRCMF_PCIE_TCM_ACCESS(devinfo, addr, expr) ({			\
+	unsigned long __flags;						\
+	void __iomem *address;						\
+	typeof(expr) __v;						\
+									\
+	spin_lock_irqsave(&(devinfo)->tcm_lock, __flags);		\
+	address = brcmf_pcie_tcm(devinfo, addr, NULL);			\
+	__v = (expr);							\
+	spin_unlock_irqrestore(&(devinfo)->tcm_lock, __flags);		\
+	__v;								\
+})
+
+static void
+brcmf_pcie_tcm_toio(struct brcmf_pciedev_info *devinfo, u32 addr, const void *src, u32 len)
+{
+	unsigned long flags;
+	u32 n;
+
+	while (len) {
+		spin_lock_irqsave(&devinfo->tcm_lock, flags);
+		void __iomem *dst = brcmf_pcie_tcm(devinfo, addr, &n);
+
+		n = min(n, len);
+		memcpy_toio(dst, src, n);
+		spin_unlock_irqrestore(&devinfo->tcm_lock, flags);
+		addr += n;
+		src += n;
+		len -= n;
+	}
+}
+
+static void
+brcmf_pcie_tcm_fromio(struct brcmf_pciedev_info *devinfo, void *dst, u32 addr, u32 len)
+{
+	unsigned long flags;
+	u32 n;
+
+	while (len) {
+		spin_lock_irqsave(&devinfo->tcm_lock, flags);
+		void __iomem *src = brcmf_pcie_tcm(devinfo, addr, &n);
+
+		n = min(n, len);
+		memcpy_fromio(dst, src, n);
+		spin_unlock_irqrestore(&devinfo->tcm_lock, flags);
+		addr += n;
+		dst += n;
+		len -= n;
+	}
+}
