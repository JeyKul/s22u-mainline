From 8b56ac4ed0c5ccf4bb578ec09266679bfdfc61e9 Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Fri, 20 Nov 2026 14:12:24 +0100
Subject: [PATCH 10/41] Input: stm-fts-spi: stop a stuck interrupt from
 storming

If the event FIFO can't be read, the level interrupt stays asserted and
the handler runs forever. Disable the interrupt after 20 failed reads in
a row.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/input/touchscreen/stm-fts-spi.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/drivers/input/touchscreen/stm-fts-spi.c b/drivers/input/touchscreen/stm-fts-spi.c
index 29908c1d6..d918744db 100644
--- a/drivers/input/touchscreen/stm-fts-spi.c
+++ b/drivers/input/touchscreen/stm-fts-spi.c
@@ -49,6 +49,7 @@ struct fts_spi {
 	struct input_dev *input;
 	struct touchscreen_properties prop;
 	struct regulator_bulk_data supplies[2];
+	unsigned int errors;
 	u8 tx[4 + FTS_EVENT_SIZE * FTS_MAX_EVENTS] ____cacheline_aligned;
 	u8 rx[4 + FTS_EVENT_SIZE * FTS_MAX_EVENTS];
 };
@@ -115,7 +116,7 @@ static irqreturn_t fts_spi_irq(int irq, void *data)
 	const u8 *ev;
 
 	if (fts_spi_read_events(ts, 1))
-		return IRQ_HANDLED;
+		goto err;
 
 	ev = ts->rx + 2;
 	left = FTS_LEFT_EVENTS(ev[7]);
@@ -123,8 +124,9 @@ static irqreturn_t fts_spi_irq(int irq, void *data)
 		left = min(left, FTS_MAX_EVENTS - 1U);
 		/* re-read the first one together with the rest */
 		if (fts_spi_read_events(ts, left + 1))
-			return IRQ_HANDLED;
+			goto err;
 	}
+	ts->errors = 0;
 
 	for (i = 0; i <= left; i++) {
 		ev = ts->rx + 2 + i * FTS_EVENT_SIZE;
@@ -136,6 +138,14 @@ static irqreturn_t fts_spi_irq(int irq, void *data)
 	input_sync(ts->input);
 
 	return IRQ_HANDLED;
+
+err:
+	/* a level interrupt that can't be serviced would storm: give up */
+	if (++ts->errors >= 20) {
+		dev_err(&ts->spi->dev, "too many SPI errors, touch disabled\n");
+		disable_irq_nosync(irq);
+	}
+	return IRQ_HANDLED;
 }
 
 static int fts_spi_wait_ready(struct fts_spi *ts)
