From cd330e3b6589825dd367bbc77d950c413c15c06a Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Fri, 20 Nov 2026 14:19:06 +0100
Subject: [PATCH 12/45] regulator: add Samsung S2MPS25/S2MPS26 over ACPM

The Exynos 2200 PMICs are reached through the ACPM firmware (PMIC
channel 2, SID 0 main / 1 sub), with all regulator registers in the PM1
block. The register map and voltage ranges come from Samsung's GPL
drivers (EVT1 tables).

Only regulators described in the device tree are registered, so
everything else stays as the bootloader and the APM firmware set it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/regulator/Kconfig        |   7 +
 drivers/regulator/Makefile       |   1 +
 drivers/regulator/s2mps25-acpm.c | 244 +++++++++++++++++++++++++++++++
 3 files changed, 252 insertions(+)
 create mode 100644 drivers/regulator/s2mps25-acpm.c

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 89789ac7a..67d3a5c04 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1460,6 +1460,13 @@ config REGULATOR_S2MPA01
 	 This driver controls Samsung S2MPA01 voltage output regulator
 	 via I2C bus. S2MPA01 has 10 Bucks and 26 LDO outputs.
 
+config REGULATOR_S2MPS25_ACPM
+	tristate "Samsung S2MPS25/S2MPS26 regulators over ACPM"
+	depends on EXYNOS_ACPM_PROTOCOL
+	help
+	  Regulators of the Samsung S2MPS25 (main) and S2MPS26 (sub) PMICs
+	  used with the Exynos 2200, accessed through the ACPM firmware.
+
 config REGULATOR_S2MPS11
 	tristate "Samsung S2MPS11/13/14/15/S2MPU02/05 voltage regulator"
 	depends on MFD_SEC_CORE || COMPILE_TEST
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 5a764cec8..43bc5faf6 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -168,6 +168,7 @@ obj-$(CONFIG_REGULATOR_RTQ6752)	+= rtq6752-regulator.o
 obj-$(CONFIG_REGULATOR_RTQ2208) += rtq2208-regulator.o
 obj-$(CONFIG_REGULATOR_S2DOS05) += s2dos05-regulator.o
 obj-$(CONFIG_REGULATOR_S2MPA01) += s2mpa01.o
+obj-$(CONFIG_REGULATOR_S2MPS25_ACPM) += s2mps25-acpm.o
 obj-$(CONFIG_REGULATOR_S2MPS11) += s2mps11.o
 obj-$(CONFIG_REGULATOR_S5M8767) += s5m8767.o
 obj-$(CONFIG_REGULATOR_SC2730) += sc2730-regulator.o
diff --git a/drivers/regulator/s2mps25-acpm.c b/drivers/regulator/s2mps25-acpm.c
new file mode 100644
index 000000000..71cfc00cc
--- /dev/null
+++ b/drivers/regulator/s2mps25-acpm.c
@@ -0,0 +1,244 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S2MPS25 / S2MPS26 PMIC regulators, reached through the ACPM
+ * firmware (Exynos 2200). Register map from Samsung's GPL s2mps25/26
+ * drivers.
+ *
+ * Only regulators described in the device tree are registered: everything
+ * else stays as the bootloader and the APM firmware set it up.
+ */
+
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/of_regulator.h>
+
+#define S2MPS_ACPM_CHAN		2	/* ACPM PMIC channel */
+#define S2MPS_TYPE_PM1		0x05	/* register block of the regulators */
+#define S2MPS_ENABLE_MASK	(0x3 << 6)
+#define S2MPS_ENABLE_ON		(0x3 << 6)
+
+#define S2MPS_REG(_name, _min, _step, _vreg, _vmask, _ereg) {	\
+	.name = _name,						\
+	.of_match = _name,					\
+	.regulators_node = "regulators",			\
+	.type = REGULATOR_VOLTAGE,				\
+	.owner = THIS_MODULE,					\
+	.ops = &s2mps_acpm_ops,					\
+	.min_uV = _min,						\
+	.uV_step = _step,					\
+	.n_voltages = (_vmask) + 1,				\
+	.vsel_reg = _vreg,					\
+	.vsel_mask = _vmask,					\
+	.enable_reg = _ereg,					\
+	.enable_mask = S2MPS_ENABLE_MASK,			\
+	.enable_val = S2MPS_ENABLE_ON,				\
+	.enable_time = 128,					\
+}
+
+struct s2mps_acpm {
+	struct acpm_handle *acpm;
+	u8 sid;
+};
+
+static const struct regulator_ops s2mps_acpm_ops = {
+	.list_voltage		= regulator_list_voltage_linear,
+	.map_voltage		= regulator_map_voltage_linear,
+	.get_voltage_sel	= regulator_get_voltage_sel_regmap,
+	.set_voltage_sel	= regulator_set_voltage_sel_regmap,
+	.set_voltage_time_sel	= regulator_set_voltage_time_sel,
+	.is_enabled		= regulator_is_enabled_regmap,
+	.enable			= regulator_enable_regmap,
+	.disable		= regulator_disable_regmap,
+};
+
+static const struct regulator_desc s2mps25_regulators[] = {
+	S2MPS_REG("ldo1m", 300000, 6250, 0xae, 0xff, 0xad),
+	S2MPS_REG("ldo2m", 300000, 6250, 0xb0, 0xff, 0xaf),
+	S2MPS_REG("ldo3m", 1500000, 12500, 0xb1, 0x3f, 0xb1),
+	S2MPS_REG("ldo4m", 300000, 6250, 0xb3, 0xff, 0xb2),
+	S2MPS_REG("ldo5m", 300000, 6250, 0xb5, 0xff, 0xb4),
+	S2MPS_REG("ldo6m", 300000, 6250, 0xb7, 0xff, 0xb6),
+	S2MPS_REG("ldo7m", 300000, 6250, 0xb9, 0xff, 0xb8),
+	S2MPS_REG("ldo9m", 300000, 6250, 0xbd, 0xff, 0xbc),
+	S2MPS_REG("ldo10m", 300000, 6250, 0xbf, 0xff, 0xbe),
+	S2MPS_REG("ldo11m", 300000, 6250, 0xc1, 0xff, 0xc0),
+	S2MPS_REG("ldo12m", 1500000, 12500, 0xc2, 0x3f, 0xc2),
+	S2MPS_REG("ldo13m", 1500000, 12500, 0xc3, 0x3f, 0xc3),
+	S2MPS_REG("ldo14m", 300000, 6250, 0xc5, 0xff, 0xc4),
+	S2MPS_REG("ldo15m", 1500000, 12500, 0xc6, 0x3f, 0xc6),
+	S2MPS_REG("ldo16m", 1500000, 12500, 0xc7, 0x3f, 0xc7),
+	S2MPS_REG("ldo17m", 700000, 25000, 0xc8, 0x3f, 0xc8),
+	S2MPS_REG("ldo18m", 1800000, 25000, 0xc9, 0x3f, 0xc9),
+	S2MPS_REG("ldo19m", 300000, 6250, 0xcb, 0xff, 0xca),
+	S2MPS_REG("ldo20m", 1500000, 12500, 0xcc, 0x3f, 0xcc),
+	S2MPS_REG("ldo21m", 1500000, 12500, 0xcd, 0x3f, 0xcd),
+	S2MPS_REG("ldo22m", 1500000, 12500, 0xce, 0x3f, 0xce),
+	S2MPS_REG("ldo23m", 1500000, 12500, 0xcf, 0x3f, 0xcf),
+	S2MPS_REG("ldo24m", 1500000, 12500, 0xd0, 0x3f, 0xd0),
+	S2MPS_REG("ldo25m", 1500000, 12500, 0xd1, 0x3f, 0xd1),
+	S2MPS_REG("ldo26m", 1500000, 12500, 0xd2, 0x3f, 0xd2),
+	S2MPS_REG("ldo27m", 1500000, 12500, 0xd3, 0x3f, 0xd3),
+	S2MPS_REG("ldo28m", 1500000, 12500, 0xd4, 0x3f, 0xd4),
+	S2MPS_REG("ldo29m", 1500000, 12500, 0xd5, 0x3f, 0xd5),
+	S2MPS_REG("ldo30m", 1500000, 12500, 0xd6, 0x3f, 0xd6),
+	S2MPS_REG("buck1m", 300000, 6250, 0x27, 0xff, 0x26),
+	S2MPS_REG("buck2m", 300000, 6250, 0x33, 0xff, 0x32),
+	S2MPS_REG("buck3m", 300000, 6250, 0x40, 0xff, 0x3e),
+	S2MPS_REG("buck4m", 300000, 6250, 0x4b, 0xff, 0x4a),
+	S2MPS_REG("buck5m", 300000, 6250, 0x57, 0xff, 0x56),
+	S2MPS_REG("buck6m", 300000, 6250, 0x63, 0xff, 0x62),
+	S2MPS_REG("buck7m", 300000, 6250, 0x71, 0xff, 0x6e),
+	S2MPS_REG("buck8m", 300000, 6250, 0x7d, 0xff, 0x7a),
+	S2MPS_REG("buck9m", 300000, 6250, 0x89, 0xff, 0x86),
+	S2MPS_REG("buck10m", 300000, 6250, 0x95, 0xff, 0x92),
+	S2MPS_REG("bucksr1m", 300000, 6250, 0x9f, 0xff, 0x9e),
+	S2MPS_REG("bucksr2m", 700000, 6250, 0xa4, 0xff, 0xa3),
+	S2MPS_REG("bucksr3m", 300000, 6250, 0xa9, 0xff, 0xa8),
+};
+
+static const struct regulator_desc s2mps26_regulators[] = {
+	S2MPS_REG("ldo1s", 300000, 6250, 0xc7, 0xff, 0xc6),
+	S2MPS_REG("ldo3s", 300000, 6250, 0xce, 0xff, 0xcd),
+	S2MPS_REG("ldo4s", 300000, 6250, 0xd0, 0xff, 0xcf),
+	S2MPS_REG("ldo6s", 300000, 6250, 0xd4, 0xff, 0xd3),
+	S2MPS_REG("ldo7s", 300000, 6250, 0xd9, 0xff, 0xd8),
+	S2MPS_REG("ldo8s", 300000, 6250, 0xdb, 0xff, 0xda),
+	S2MPS_REG("ldo9s", 300000, 6250, 0xde, 0xff, 0xdc),
+	S2MPS_REG("ldo14s", 1800000, 25000, 0xe9, 0x3f, 0xe9),
+	S2MPS_REG("ldo15s", 1800000, 25000, 0xea, 0x3f, 0xea),
+	S2MPS_REG("ldo16s", 1800000, 25000, 0xeb, 0x3f, 0xeb),
+	S2MPS_REG("ldo17s", 1800000, 25000, 0xec, 0x3f, 0xec),
+	S2MPS_REG("ldo18s", 1800000, 25000, 0xed, 0x3f, 0xed),
+	S2MPS_REG("ldo19s", 1800000, 25000, 0xee, 0x3f, 0xee),
+	S2MPS_REG("ldo20s", 1800000, 25000, 0xef, 0x3f, 0xef),
+	S2MPS_REG("buck1s", 300000, 6250, 0x21, 0xff, 0x1f),
+	S2MPS_REG("buck2s", 300000, 6250, 0x2d, 0xff, 0x2b),
+	S2MPS_REG("buck3s", 300000, 6250, 0x38, 0xff, 0x37),
+	S2MPS_REG("buck4s", 300000, 6250, 0x44, 0xff, 0x43),
+	S2MPS_REG("buck5s", 300000, 6250, 0x51, 0xff, 0x4f),
+	S2MPS_REG("buck6s", 300000, 6250, 0x5d, 0xff, 0x5b),
+	S2MPS_REG("buck7s", 300000, 6250, 0x69, 0xff, 0x67),
+	S2MPS_REG("bucksr1s", 300000, 6250, 0xb0, 0xff, 0xaf),
+};
+
+static int s2mps_acpm_reg_read(void *ctx, unsigned int reg, unsigned int *val)
+{
+	struct s2mps_acpm *pmic = ctx;
+	u8 v;
+	int ret;
+
+	ret = pmic->acpm->ops->pmic.read_reg(pmic->acpm, S2MPS_ACPM_CHAN,
+					     S2MPS_TYPE_PM1, reg, pmic->sid, &v);
+	*val = v;
+	return ret;
+}
+
+static int s2mps_acpm_reg_write(void *ctx, unsigned int reg, unsigned int val)
+{
+	struct s2mps_acpm *pmic = ctx;
+
+	return pmic->acpm->ops->pmic.write_reg(pmic->acpm, S2MPS_ACPM_CHAN,
+					       S2MPS_TYPE_PM1, reg, pmic->sid,
+					       val);
+}
+
+static const struct regmap_config s2mps_acpm_regmap = {
+	.reg_bits = 8,
+	.val_bits = 8,
+	.max_register = 0xff,
+	.reg_read = s2mps_acpm_reg_read,
+	.reg_write = s2mps_acpm_reg_write,
+	.cache_type = REGCACHE_NONE,
+};
+
+struct s2mps_acpm_data {
+	const struct regulator_desc *descs;
+	unsigned int num_descs;
+	u8 sid;
+};
+
+static int s2mps_acpm_probe(struct platform_device *pdev)
+{
+	const struct s2mps_acpm_data *data = of_device_get_match_data(&pdev->dev);
+	struct device *dev = &pdev->dev;
+	struct regulator_config config = { };
+	struct device_node *regs_np;
+	struct s2mps_acpm *pmic;
+	struct regmap *regmap;
+	unsigned int i;
+
+	pmic = devm_kzalloc(dev, sizeof(*pmic), GFP_KERNEL);
+	if (!pmic)
+		return -ENOMEM;
+	pmic->sid = data->sid;
+
+	pmic->acpm = devm_acpm_get_by_node(dev, dev->parent->of_node);
+	if (IS_ERR(pmic->acpm))
+		return dev_err_probe(dev, PTR_ERR(pmic->acpm), "no ACPM handle\n");
+
+	regmap = devm_regmap_init(dev, NULL, pmic, &s2mps_acpm_regmap);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	regs_np = of_get_child_by_name(dev->of_node, "regulators");
+	if (!regs_np)
+		return 0;
+
+	config.dev = dev;
+	config.regmap = regmap;
+
+	for (i = 0; i < data->num_descs; i++) {
+		const struct regulator_desc *desc = &data->descs[i];
+		struct device_node *np = of_get_child_by_name(regs_np, desc->of_match);
+		struct regulator_dev *rdev;
+
+		if (!np)
+			continue;
+		of_node_put(np);
+
+		rdev = devm_regulator_register(dev, desc, &config);
+		if (IS_ERR(rdev)) {
+			of_node_put(regs_np);
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n", desc->name);
+		}
+	}
+	of_node_put(regs_np);
+
+	return 0;
+}
+
+static const struct s2mps_acpm_data s2mps25_data = {
+	.descs = s2mps25_regulators,
+	.num_descs = ARRAY_SIZE(s2mps25_regulators),
+	.sid = 0,
+};
+
+static const struct s2mps_acpm_data s2mps26_data = {
+	.descs = s2mps26_regulators,
+	.num_descs = ARRAY_SIZE(s2mps26_regulators),
+	.sid = 1,
+};
+
+static const struct of_device_id s2mps_acpm_of_match[] = {
+	{ .compatible = "samsung,s2mps25-pmic", .data = &s2mps25_data },
+	{ .compatible = "samsung,s2mps26-pmic", .data = &s2mps26_data },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mps_acpm_of_match);
+
+static struct platform_driver s2mps_acpm_driver = {
+	.driver = {
+		.name = "s2mps25-acpm-regulator",
+		.of_match_table = s2mps_acpm_of_match,
+	},
+	.probe = s2mps_acpm_probe,
+};
+module_platform_driver(s2mps_acpm_driver);
+
+MODULE_DESCRIPTION("Samsung S2MPS25/S2MPS26 regulators over ACPM");
+MODULE_LICENSE("GPL");
