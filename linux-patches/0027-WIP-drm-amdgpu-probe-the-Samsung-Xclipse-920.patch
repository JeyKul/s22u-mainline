diff --git a/drivers/gpu/drm/amd/amdgpu/xclipse920_reg_init.c b/drivers/gpu/drm/amd/amdgpu/xclipse920_reg_init.c
new file mode 100644
index 000000000..9b9023c81
--- /dev/null
+++ b/drivers/gpu/drm/amd/amdgpu/xclipse920_reg_init.c
@@ -0,0 +1,41 @@
+// SPDX-License-Identifier: MIT
+/*
+ * Samsung Xclipse 920 (Exynos 2200): an RDNA2 GC ("Van Gogh lite", GC 10.4)
+ * without IP discovery, VBIOS, VRAM, PSP or SMU, presented to amdgpu as
+ * 1002:163F by drivers/pci/controller/pci-exynos2200-gpu.c.
+ *
+ * Register bases are Samsung's (vangogh_lite_ip_offset.h), in dwords from
+ * the GC window (BAR5). GC 10.4 matches GC 10.3.0's register map except
+ * for 36 registers (ring sizes, SPI config, SQ thread trace).
+ */
+#include "amdgpu.h"
+#include "nv.h"
+#include "soc15_common.h"
+
+#include "gc/gc_10_3_0_offset.h"
+
+/* segment bases of instance 0; the other instances do not exist */
+static const u32 xclipse920_gc_base[6] = { 0x00001260, 0x0000a000 };
+static const u32 xclipse920_nbio_base[6] = { 0x00000000, 0x00000014, 0x00000d20,
+					     0x00010400, 0x0241b000 };
+static const u32 xclipse920_none[6];
+
+int xclipse920_set_ip_blocks(struct amdgpu_device *adev)
+{
+	u32 i;
+
+	adev->gfx.xcc_mask = 1;
+	for (i = 0; i < HWIP_MAX_INSTANCE; ++i) {
+		adev->reg_offset[GC_HWIP][i] = (u32 *)(i ? xclipse920_none : xclipse920_gc_base);
+		adev->reg_offset[NBIO_HWIP][i] = (u32 *)(i ? xclipse920_none : xclipse920_nbio_base);
+	}
+	adev->ip_versions[GC_HWIP][0] = IP_VERSION(10, 3, 1);
+
+	/* bring-up milestone: amdgpu's own accessors reach the GC */
+	dev_info(adev->dev, "Xclipse 920: GRBM_CHIP_REVISION %08x GRBM_STATUS %08x GB_ADDR_CONFIG %08x\n",
+		 RREG32_SOC15(GC, 0, mmGRBM_CHIP_REVISION),
+		 RREG32_SOC15(GC, 0, mmGRBM_STATUS),
+		 RREG32_SOC15(GC, 0, mmGB_ADDR_CONFIG));
+
+	return -ENODEV;	/* IP blocks not wired up yet */
+}
