 drivers/gpu/drm/amd/amdgpu/nv.h               |  1 +
 .../gpu/drm/amd/amdgpu/xclipse920_reg_init.c  | 41 +++++++++++++++++++
 5 files changed, 51 insertions(+), 1 deletion(-)
 create mode 100644 drivers/gpu/drm/amd/amdgpu/xclipse920_reg_init.c

