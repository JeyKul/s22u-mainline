@@ -3087,6 +3087,9 @@ int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 	int r;
 
 	switch (adev->asic_type) {
+	case CHIP_VANGOGH:
+		/* only the Xclipse 920 gets here (explicit PCI ID, no discovery) */
