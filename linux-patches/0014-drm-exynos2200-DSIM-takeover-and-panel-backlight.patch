+			dsim_regs_desc(id)->regs + DSIM_LINK_STATUS0, val,
+			!DSIM_LINK_STATUS0_VIDEO_MODE_STATUS_GET(val), 10,
+			2000);
+	if (ret) {
+		cal_log_err(id, "dsim%d wait timeout idle status\n", id);
+		return ret;
+	}
+
+	return 0;
+}
