+	dsim_reg_get_cmd_timer(config->p_timing.vrefresh, &time_te_protect_on,
+			       &time_te_tout, clks->hs_clk);
+	dsim_reg_set_cmd_te_ctrl0(id, time_stable_vfp);
+	dsim_reg_set_cmd_te_ctrl1(id, time_te_protect_on, time_te_tout);
+}
