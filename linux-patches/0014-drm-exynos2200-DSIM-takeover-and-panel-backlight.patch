+#define DSIM_PHY_THS_TRAIL(_x)			(((_x) & 0xff) << 0)
+#define DSIM_PHY_THS_TRAIL_MASK			(0xff << 0)
+
+/* MC_TIME_CON3 */
+#define DSIM_PHY_TCLK_POST(_x)			(((_x) & 0xff) << 0)
+#define DSIM_PHY_TCLK_POST_MASK			(0xff << 0)
+/* MD_TIME_CON3 */
+#define DSIM_PHY_TTA_GET(_x)			(((_x) & 0xf) << 4)
+#define DSIM_PHY_TTA_GET_MASK			(0xf << 4)
+#define DSIM_PHY_TTA_GO(_x)			(((_x) & 0xf) << 0)
+#define DSIM_PHY_TTA_GO_MASK			(0xf << 0)
+
+/* MC/MD_TIME_CON4 */
+#define DSIM_PHY_ULPS_EXIT(_x)			(((_x) & 0x3ff) << 0)
+#define DSIM_PHY_ULPS_EXIT_MASK			(0x3ff << 0)
+
+/* MC_DATA_CON0 */
+#define DSIM_PHY_CLK_INV			(0x1 << 1)
+/* MC_DATA_CON0 */
+#define DSIM_PHY_DATA_INV			(0x1 << 1)
+
+/* MC_DESKEW_CON0 */
+#define DSIM_PHY_SKEWCAL_RUN_TIME(_x)		(((_x) & 0xf) << 12)
+#define DSIM_PHY_SKEWCAL_RUN_TIME_MASK		(0xf << 12)
+#define DSIM_PHY_SKEWCAL_INIT_RUN_TIME(_x)	(((_x) & 0xf) << 8)
+#define DSIM_PHY_SKEWCAL_INIT_RUN_TIME_MASK	(0xf << 8)
+#define DSIM_PHY_SKEWCAL_INIT_WAIT_TIME(_x)	(((_x) & 0xf) << 4)
+#define DSIM_PHY_SKEWCAL_INIT_WAIT_TIME_MASK	(0xf << 4)
+#define DSIM_PHY_SKEWCAL_EN			(0x1 << 0)
+
+#endif /* _REGS_DSIM_H */
diff --git a/drivers/gpu/drm/exynos2200/exynos2200_dsim.c b/drivers/gpu/drm/exynos2200/exynos2200_dsim.c
new file mode 100644
index 000000000..59e77da8e
--- /dev/null
+++ b/drivers/gpu/drm/exynos2200/exynos2200_dsim.c
@@ -0,0 +1,284 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 2200 DSIM: takes over the DSI link that the bootloader left running
+ * (DECON0 in command mode, DSC), re-initialises it with Samsung's register
+ * sequence so that DCS commands reach the panel, and exposes the panel
+ * brightness (Samsung S6E3HAE on the Galaxy S22 Ultra) as a backlight.
+ *
+ * The register layer (cal/) is Samsung's, from the s5e9925 kernel.
+ */
+
+#include <linux/backlight.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/uaccess.h>
+#include <video/mipi_display.h>
+
+#include <cal_config.h>
+#include <dsim_cal.h>
+#include <regs-dsim.h>
+
+#define DECON_TRIG_CON		0x30
+#define DECON_HW_TRIG_EN	BIT(0)
+
+/* S6E3HAE: normal brightness range of DCS 51h (HBM above is not exposed) */
+#define S6E3HAE_BRT_MIN		0x0008
+#define S6E3HAE_BRT_MAX		0x07ff
+
+struct exynos2200_dsim {
+	struct device *dev;
+	void __iomem *regs;
+	void __iomem *decon;
+	struct mutex lock;
+	struct backlight_device *bl;
+	struct dentry *dbg;
+};
+
+void dpu_print_hex_dump(void __iomem *regs, const void *buf, size_t len)
+{
+	print_hex_dump(KERN_INFO, "", DUMP_PREFIX_OFFSET, 32, 4, buf, len, false);
+}
+
+/* Samsung's dsim_write_data(), SFR path, command mode with burst commands */
+static int exynos2200_dsim_write(struct exynos2200_dsim *dsim, const u8 *buf,
+				 size_t len)
+{
+	u32 fifo;
+	u8 id;
+	int ret;
+
+	if (!len || len > 64)
+		return -EINVAL;
+
+	mutex_lock(&dsim->lock);
+	dsim_reg_clear_int(0, DSIM_INTSRC_SFR_PH_FIFO_EMPTY);
+
+	if (len == 1) {
+		id = MIPI_DSI_DCS_SHORT_WRITE;
+		dsim_reg_wr_tx_header(0, id, buf[0], 0, false);
+	} else if (len == 2) {
+		id = MIPI_DSI_DCS_SHORT_WRITE_PARAM;
+		dsim_reg_wr_tx_header(0, id, buf[0], buf[1], false);
+	} else {
+		size_t i, j;
+
+		id = MIPI_DSI_DCS_LONG_WRITE;
+		for (i = 0; i < len; i += 4) {
+			u32 w = 0;
+
+			for (j = 0; j < 4 && i + j < len; j++)
+				w |= buf[i + j] << (8 * j);
+			dsim_reg_wr_tx_payload(0, w);
+		}
+		dsim_reg_wr_tx_header(0, id, len & 0xff, len >> 8, false);
+	}
+	dsim_reg_set_packetgo_ready(0);
+
+	ret = readl_poll_timeout(dsim->regs + DSIM_FIFOCTRL, fifo,
+				 fifo & DSIM_FIFOCTRL_EMPTY_PH_SFR, 100, 100000);
+	mutex_unlock(&dsim->lock);
+
+	if (ret)
+		dev_err(dsim->dev, "DCS %*ph: timeout (FIFOCTRL %08x)\n",
+			(int)len, buf, fifo);
+	return ret;
+}
+
+#define dsim_dcs(dsim, ...) ({						\
+	static const u8 __d[] = { __VA_ARGS__ };			\
+	exynos2200_dsim_write(dsim, __d, ARRAY_SIZE(__d));		\
+})
+
+static int s6e3hae_set_brightness(struct exynos2200_dsim *dsim, u16 level)
+{
+	u8 wrdisbv[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, level >> 8, level & 0xff };
+	int ret;
+
+	ret = dsim_dcs(dsim, 0x9f, 0xa5, 0xa5);		/* level 1 key */
+	ret = ret ?: dsim_dcs(dsim, 0xf0, 0x5a, 0x5a);	/* level 2 key */
+	ret = ret ?: exynos2200_dsim_write(dsim, wrdisbv, sizeof(wrdisbv));
+	ret = ret ?: dsim_dcs(dsim, 0xf7, 0x0f);		/* gamma update */
+	ret = ret ?: dsim_dcs(dsim, 0xf0, 0xa5, 0xa5);
+	ret = ret ?: dsim_dcs(dsim, 0x9f, 0x5a, 0x5a);
+	return ret;
+}
+
+static int exynos2200_dsim_bl_update(struct backlight_device *bl)
+{
+	struct exynos2200_dsim *dsim = bl_get_data(bl);
+	int level = backlight_get_brightness(bl);
+
+	/* 0 (and blanking) goes to the dimmest level, not off */
+	return s6e3hae_set_brightness(dsim, S6E3HAE_BRT_MIN + level);
+}
+
+static const struct backlight_ops exynos2200_dsim_bl_ops = {
+	.options = BL_CORE_SUSPENDRESUME,
+	.update_status = exynos2200_dsim_bl_update,
+};
+
+static ssize_t exynos2200_dsim_dbg_write(struct file *f, const char __user *ubuf,
+					 size_t count, loff_t *ppos)
+{
+	struct exynos2200_dsim *dsim = file_inode(f)->i_private;
+	char kbuf[256], *p, *tok;
+	u8 data[64];
+	size_t n = 0;
+	int ret;
+
+	if (count >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, count))
+		return -EFAULT;
+	kbuf[count] = '\0';
+
+	p = kbuf;
+	while ((tok = strsep(&p, " \n")) && n < sizeof(data)) {
+		if (!*tok)
+			continue;
+		if (kstrtou8(tok, 16, &data[n++]))
+			return -EINVAL;
+	}
+
+	ret = exynos2200_dsim_write(dsim, data, n);
+	return ret ?: count;
+}
+
+static const struct file_operations exynos2200_dsim_dbg_fops = {
+	.open = simple_open,
+	.write = exynos2200_dsim_dbg_write,
+};
+
+/*
+ * Re-initialise DSIM0 the way Samsung's driver does. The panel is left
+ * alone: it keeps its state and image while DECON's TE trigger is paused.
+ */
+static void exynos2200_dsim_reinit(struct exynos2200_dsim *dsim)
+{
+	struct dsim_reg_config config = {
+		.mode = DSIM_COMMAND_MODE,
+		.p_timing = {
+			.vactive = 3088,
+			.hactive = 1440,
+			.vrefresh = 60,
+		},
+		.dphy_pms = { .p = 5, .m = 0x59, .s = 0, .k = 0xac00 },
+		.ddi_type = TYPE_OF_SM_DDI,
+		.bpc = 8,
+		.data_lane_cnt = 4,
+		.dsc = {
+			.enabled = true,
+			.dsc_count = 2,
+			.slice_count = 2,
+			.slice_width = 720,
+			.slice_height = 193,
+		},
+		.burst_cmd_en = 1,
+	};
+	struct dsim_clks clks = { .hs_clk = 1362, .esc_clk = 20 };
+	u32 trig = readl(dsim->decon + DECON_TRIG_CON);
+	u32 te0 = readl(dsim->regs + DSIM_CMD_TE_CTRL0);
+	u32 te1 = readl(dsim->regs + DSIM_CMD_TE_CTRL1);
+
+	config.cmd_underrun_cnt = readl(dsim->regs + DSIM_UNDERRUN_CTRL) & 0xffff;
+
+	writel(trig & ~DECON_HW_TRIG_EN, dsim->decon + DECON_TRIG_CON);
+	msleep(40);
+
+	dsim_reg_stop(0, DSIM_LANE_CLOCK | GENMASK(config.data_lane_cnt, 1));
+	dsim_reg_init(0, &config, &clks, false);
+	dsim_reg_start(0);
+
+	/* the bootloader's TE protect/timeout window, computed for this link */
+	writel(te0, dsim->regs + DSIM_CMD_TE_CTRL0);
+	writel(te1, dsim->regs + DSIM_CMD_TE_CTRL1);
+
+	writel(trig, dsim->decon + DECON_TRIG_CON);
+}
+
+static int exynos2200_dsim_probe(struct platform_device *pdev)
+{
+	struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.max_brightness = S6E3HAE_BRT_MAX - S6E3HAE_BRT_MIN,
+		.brightness = 0x300 - S6E3HAE_BRT_MIN,
+		.scale = BACKLIGHT_SCALE_NON_LINEAR,
+	};
+	struct device *dev = &pdev->dev;
+	struct exynos2200_dsim *dsim;
+	struct resource *res;
+	static const char * const names[] = { "dsi", "dphy", "dphy-extra", "sys" };
+	static const enum dsim_regs_type types[] = {
+		REGS_DSIM_DSI, REGS_DSIM_PHY, REGS_DSIM_PHY_BIAS, REGS_DSIM_SYS,
+	};
+	int i;
+
+	dsim = devm_kzalloc(dev, sizeof(*dsim), GFP_KERNEL);
+	if (!dsim)
+		return -ENOMEM;
+	dsim->dev = dev;
+	mutex_init(&dsim->lock);
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		void __iomem *base = devm_platform_ioremap_resource_byname(pdev, names[i]);
+
+		if (IS_ERR(base))
+			return PTR_ERR(base);
+		dsim_regs_desc_init(base, names[i], types[i], 0);
+		if (!i)
+			dsim->regs = base;
+	}
+
+	/* DECON0 is shared with the display driver: map, don't claim */
+	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "decon");
+	if (!res)
+		return -EINVAL;
+	dsim->decon = devm_ioremap(dev, res->start, resource_size(res));
+	if (!dsim->decon)
+		return -ENOMEM;
+
+	exynos2200_dsim_reinit(dsim);
+
+	dsim->bl = devm_backlight_device_register(dev, "panel", dev, dsim,
+						  &exynos2200_dsim_bl_ops, &props);
+	if (IS_ERR(dsim->bl))
+		return PTR_ERR(dsim->bl);
+	backlight_update_status(dsim->bl);
+
+	dsim->dbg = debugfs_create_file("exynos2200-dsim-dcs", 0200, NULL, dsim,
+					&exynos2200_dsim_dbg_fops);
+	platform_set_drvdata(pdev, dsim);
+	return 0;
+}
+
+static void exynos2200_dsim_remove(struct platform_device *pdev)
+{
+	struct exynos2200_dsim *dsim = platform_get_drvdata(pdev);
+
+	debugfs_remove(dsim->dbg);
+}
+
+static const struct of_device_id exynos2200_dsim_of_match[] = {
+	{ .compatible = "samsung,exynos2200-dsim" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, exynos2200_dsim_of_match);
+
+static struct platform_driver exynos2200_dsim_driver = {
+	.driver = {
+		.name = "exynos2200-dsim",
+		.of_match_table = exynos2200_dsim_of_match,
+	},
+	.probe = exynos2200_dsim_probe,
+	.remove = exynos2200_dsim_remove,
+};
+module_platform_driver(exynos2200_dsim_driver);
+
+MODULE_DESCRIPTION("Exynos 2200 DSIM takeover and panel backlight");
+MODULE_LICENSE("GPL");
