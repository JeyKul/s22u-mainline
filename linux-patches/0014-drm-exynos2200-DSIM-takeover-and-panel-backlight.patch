+static int dsim_reg_set_lanes_dphy(u32 id, u32 lanes, bool en)
+{
+	/* PHY lanes */
+	if (dsim_reg_enable_lane_phy(id, (lanes >> 1), en))
+		return -EBUSY;
+
+	return 0;
+}
