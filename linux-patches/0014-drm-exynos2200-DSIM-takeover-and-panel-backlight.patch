+{
+	u32 val = rst ? ~0 : 0;
+	u32 mask = id ? M_RESETN_M1_MASK : M_RESETN_M0_MASK;
+
+	dsim_sys_write_mask(id, DPU_MIPI_PHY_CON, val, mask);
