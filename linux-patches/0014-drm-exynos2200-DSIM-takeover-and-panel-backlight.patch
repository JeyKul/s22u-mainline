+static bool dsim_reg_is_pll_stable(u32 id)
+{
+	u32 val, pll_lock;
+
+	val = dsim_phy_read(id, DSIM_PHY_PLL_STAT0);
+	pll_lock = DSIM_PHY_PLL_LOCK_GET(val);
+
+	return pll_lock != 0;
+}
