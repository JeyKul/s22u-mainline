+	dsim_phy_write_mask(id, 0x057c, 0x2, (0xffff << 0));
+	dsim_phy_write_mask(id, 0x067c, 0x2, (0xffff << 0));
+	dsim_phy_write_mask(id, 0x077c, 0x2, (0xffff << 0));
+}
