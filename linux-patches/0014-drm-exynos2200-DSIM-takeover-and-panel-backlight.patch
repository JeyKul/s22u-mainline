--- /dev/null
+++ b/drivers/gpu/drm/exynos2200/Kconfig
@@ -0,0 +1,9 @@
+config DRM_EXYNOS2200_DSIM
+	tristate "Exynos 2200 DSIM takeover and panel backlight"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	select BACKLIGHT_CLASS_DEVICE
+	help
+	  Re-initialises the DSI link that the bootloader left running on
+	  Exynos 2200 (DECON0, command mode, DSC) so that the panel accepts
+	  commands, and exposes the panel brightness as a backlight. Used on
+	  the Samsung Galaxy S22 Ultra together with simpledrm.
