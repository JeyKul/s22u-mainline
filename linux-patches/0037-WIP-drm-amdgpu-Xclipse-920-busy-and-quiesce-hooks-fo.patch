From b943f42ff49f71790d1f536feaf459d8f11b542c Mon Sep 17 00:00:00 2001
From: JeyKul <77121325+JeyKul@users.noreply.github.com>
Date: Thu, 26 Nov 2026 17:30:39 +0100
Subject: [PATCH 37/59] WIP: drm/amdgpu: Xclipse 920: busy and quiesce hooks
 for the G3D DVFS governor

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_device.c    |  3 +
 .../gpu/drm/amd/amdgpu/xclipse920_compat.c    | 64 +++++++++++++++++++
 .../gpu/drm/amd/amdgpu/xclipse920_compat.h    |  3 +
 3 files changed, 70 insertions(+)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
index 1333dbc36..d033bfaa9 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_device.c
@@ -48,6 +48,7 @@
 #include <linux/vga_switcheroo.h>
 #include <linux/efi.h>
 #include "amdgpu.h"
+#include "xclipse920_compat.h"
 #include "amdgpu_trace.h"
 #include "amdgpu_i2c.h"
 #include "atom.h"
@@ -4163,6 +4164,7 @@ int amdgpu_device_init(struct amdgpu_device *adev,
 		}
 		/* must succeed. */
 		amdgpu_ras_resume(adev);
+		xclipse920_dvfs_init(adev);
 		queue_delayed_work(system_dfl_wq, &adev->delayed_init_work,
 				   msecs_to_jiffies(AMDGPU_RESUME_MS));
 	}
@@ -4276,6 +4278,7 @@ static void amdgpu_device_unmap_mmio(struct amdgpu_device *adev)
 void amdgpu_device_fini_hw(struct amdgpu_device *adev)
 {
 	dev_info(adev->dev, "finishing device.\n");
+	xclipse920_dvfs_fini(adev);
 	flush_delayed_work(&adev->delayed_init_work);
 
 	if (adev->mman.initialized)
diff --git a/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.c b/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.c
index c7b2b8a9d..4b3ea684b 100644
--- a/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.c
+++ b/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.c
@@ -301,3 +301,67 @@ void xclipse920_ibdump(struct amdgpu_cs_parser *p)
 out:
 	mutex_unlock(&ibdump_lock);
 }
+
+/*
+ * GPU DVFS lives in the Exynos 2200 G3D power driver (it talks to ACPM); it asks
+ * here whether work is queued on the GFX or compute rings.
+ */
+#include <linux/soc/samsung/exynos2200-g3d.h>
+
+static bool xclipse920_busy(void *data)
+{
+	struct amdgpu_device *adev = data;
+	int i;
+
+	for (i = 0; i < adev->gfx.num_gfx_rings; i++)
+		if (amdgpu_fence_count_emitted(&adev->gfx.gfx_ring[i]))
+			return true;
+	for (i = 0; i < adev->gfx.num_compute_rings; i++)
+		if (amdgpu_fence_count_emitted(&adev->gfx.compute_ring[i]))
+			return true;
+	return false;
+}
+
+static bool xclipse920_dvfs_quiesce;
+module_param_named(xclipse_dvfs_quiesce, xclipse920_dvfs_quiesce, bool, 0644);
+MODULE_PARM_DESC(xclipse_dvfs_quiesce, "Xclipse 920: drain the rings around GPU clock switches (not needed so far)");
+
+/* hold the schedulers and wait for the rings to drain (stop), or let them run again */
+static int xclipse920_quiesce(void *data, bool stop)
+{
+	struct amdgpu_device *adev = data;
+	struct amdgpu_ring *rings[AMDGPU_MAX_GFX_RINGS + AMDGPU_MAX_COMPUTE_RINGS];
+	int i, n = 0, ret = 0;
+
+	if (!READ_ONCE(xclipse920_dvfs_quiesce))
+		return 0;
+	for (i = 0; i < adev->gfx.num_gfx_rings; i++)
+		rings[n++] = &adev->gfx.gfx_ring[i];
+	for (i = 0; i < adev->gfx.num_compute_rings; i++)
+		rings[n++] = &adev->gfx.compute_ring[i];
+
+	for (i = 0; i < n; i++) {
+		if (!rings[i]->sched.ready)
+			continue;
+		if (stop)
+			drm_sched_wqueue_stop(&rings[i]->sched);
+		else
+			drm_sched_wqueue_start(&rings[i]->sched);
+	}
+	for (i = 0; stop && i < n && !ret; i++)
+		if (rings[i]->sched.ready)
+			ret = amdgpu_fence_wait_empty(rings[i]);
+	return ret;
+}
+
+void xclipse920_dvfs_init(struct amdgpu_device *adev)
+{
+	if (amdgpu_is_xclipse920(adev))
+		exynos2200_g3d_set_gpu_ops(xclipse920_busy, xclipse920_quiesce, adev);
+}
+
+void xclipse920_dvfs_fini(struct amdgpu_device *adev)
+{
+	if (amdgpu_is_xclipse920(adev))
+		exynos2200_g3d_set_gpu_ops(NULL, NULL, NULL);
+}
diff --git a/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.h b/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.h
index 7977707ab..0e862fdb8 100644
--- a/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.h
+++ b/drivers/gpu/drm/amd/amdgpu/xclipse920_compat.h
@@ -61,6 +61,9 @@ int xclipse920_wgp_gating_ioctl(struct drm_device *dev, void *data, struct drm_f
 int xclipse920_mem_profile_add_ioctl(struct drm_device *dev, void *data, struct drm_file *filp);
 
 struct amdgpu_cs_parser;
+struct amdgpu_device;
+void xclipse920_dvfs_init(struct amdgpu_device *adev);
+void xclipse920_dvfs_fini(struct amdgpu_device *adev);
 void xclipse920_ibdump(struct amdgpu_cs_parser *p);
 
 #endif
