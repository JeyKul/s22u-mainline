From 986b3ee0dfb719866cc341ec99a6fcbf63f7ecbd Mon Sep 17 00:00:00 2001
From: JeyKul <minkajey@gmail.com>
Date: Fri, 20 Nov 2026 14:04:12 +0100
Subject: [PATCH 09/47] arm64: dts: exynos2200-b0s: add the ACPM mailbox and
 SRAM

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos2200-b0s.dts | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
index 47ecbd8bf..8d4a2b63e 100644
--- a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
+++ b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
@@ -221,7 +221,32 @@ el2-earlymem@afe600000 {
 	};
 };
 
+/ {
+	firmware {
+		acpm_ipc: power-management {
+			compatible = "samsung,exynos2200-acpm-ipc";
+			mboxes = <&ap2apm_mailbox>;
+			shmem = <&apm_sram>;
+		};
+	};
+};
+
 &{/soc@0} {
+	apm_sram: sram@2060000 {
+		compatible = "mmio-sram";
+		reg = <0x2060000 0x50000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x2060000 0x50000>;
+	};
+
+	ap2apm_mailbox: mailbox@15900000 {
+		compatible = "samsung,exynos2200-mbox";
+		reg = <0x15900000 0x1000>;
+		interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH 0>;
+		#mbox-cells = <0>;
+	};
+
 	ufs_phy: phy@11104000 {
 		compatible = "samsung,exynos2200-ufs-phy";
 		reg = <0x11104000 0x4000>;
-- 
2.56.1

