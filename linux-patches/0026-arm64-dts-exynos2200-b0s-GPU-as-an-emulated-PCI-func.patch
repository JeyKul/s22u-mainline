From 7da88a98579a05061816c2bb4e177776c1f59e26 Mon Sep 17 00:00:00 2001
From: JeyKul <jey@kulovac.de>
Date: Fri, 20 Nov 2026 21:52:32 +0100
Subject: [PATCH 26/57] arm64: dts: exynos2200-b0s: GPU as an emulated PCI
 function

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/exynos2200-b0s.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
index 89bb1d342..5fdf57cfc 100644
--- a/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
+++ b/arch/arm64/boot/dts/exynos/exynos2200-b0s.dts
@@ -316,6 +316,23 @@ power-controller@16cd0000 {
 		samsung,tzpc-addr = <0x16c10204>;
 	};
 
+	/* Xclipse 920 as an emulated PCI function for amdgpu (BAR5 GC, BAR2 doorbells) */
+	pci@16e00000 {
+		compatible = "samsung,exynos2200-gpu-pci";
+		reg = <0x16e00000 0x100000>, <0x16f00000 0x100000>;
+		reg-names = "mmio", "doorbell";
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		#interrupt-cells = <1>;
+		bus-range = <0x00 0x00>;
+		linux,pci-probe-only = <1>;
+		ranges = <0x02000000 0x0 0x16e00000 0x16e00000 0x0 0x200000>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &gic GIC_SPI 467 IRQ_TYPE_LEVEL_HIGH 0>;
+		dma-coherent;
+	};
+
 	/* takes over the DSI link S-Boot left running; panel brightness */
 	dsi@19eb0000 {
 		compatible = "samsung,exynos2200-dsim";
-- 
