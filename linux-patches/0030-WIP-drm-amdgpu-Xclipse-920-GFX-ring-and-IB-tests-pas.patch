@@ -245,11 +245,17 @@ static void gfxhub_v2_1_init_cache_regs(struct amdgpu_device *adev)
 		tmp = REG_SET_FIELD(tmp, GCVM_L2_CNTL3,
 				    L2_CACHE_BIGK_FRAGMENT_SIZE, 6);
 	}
+	/* Xclipse 920: sgpu's value */
+	if (amdgpu_is_xclipse920(adev))
+		tmp = 0x00100003;
 	WREG32_SOC15(GC, 0, mmGCVM_L2_CNTL3, tmp);
 
+	/* page tables in system RAM: the walker fetches them by physical address */
 	tmp = mmGCVM_L2_CNTL4_DEFAULT;
-	tmp = REG_SET_FIELD(tmp, GCVM_L2_CNTL4, VMC_TAP_PDE_REQUEST_PHYSICAL, 0);
-	tmp = REG_SET_FIELD(tmp, GCVM_L2_CNTL4, VMC_TAP_PTE_REQUEST_PHYSICAL, 0);
+	tmp = REG_SET_FIELD(tmp, GCVM_L2_CNTL4, VMC_TAP_PDE_REQUEST_PHYSICAL,
+			    amdgpu_is_xclipse920(adev));
+	tmp = REG_SET_FIELD(tmp, GCVM_L2_CNTL4, VMC_TAP_PTE_REQUEST_PHYSICAL,
+			    amdgpu_is_xclipse920(adev));
 	WREG32_SOC15(GC, 0, mmGCVM_L2_CNTL4, tmp);
 
 	tmp = mmGCVM_L2_CNTL5_DEFAULT;
diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
