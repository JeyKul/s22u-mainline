+		r = gfx_v10_0_kiq_resume(adev);
+		if (r)
+			return r;
 
-	r = gfx_v10_0_kcq_resume(adev);
-	if (r)
-		return r;
+		r = gfx_v10_0_kcq_resume(adev);
+		if (r)
+			return r;
+	}
 
 	if (!amdgpu_async_gfx_ring) {
 		r = gfx_v10_0_cp_gfx_resume(adev);
@@ -7499,7 +7575,8 @@ static int gfx_v10_0_hw_init(struct amdgpu_ip_block *ip_block)
 	amdgpu_gfx_cleaner_shader_init(adev, adev->gfx.cleaner_shader_size,
 				       adev->gfx.cleaner_shader_ptr);
 
-	if (adev->firmware.load_type == AMDGPU_FW_LOAD_DIRECT) {
+	if (adev->firmware.load_type == AMDGPU_FW_LOAD_DIRECT &&
+	    !amdgpu_is_xclipse920(adev)) {
 		/**
 		 * For gfx 10, rlc firmware loading relies on smu firmware is
 		 * loaded firstly, so in direct type, it has to load smc ucode
@@ -7578,7 +7655,7 @@ static int gfx_v10_0_hw_fini(struct amdgpu_ip_block *ip_block)
 	if (amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 3, 1))
 		gfx_v10_0_set_powergating_state(ip_block, AMD_PG_STATE_UNGATE);
 
-	if (!adev->no_hw_access) {
+	if (!adev->no_hw_access && !amdgpu_is_xclipse920(adev)) {
 		if (amdgpu_async_gfx_ring) {
 			if (amdgpu_gfx_disable_kgq(adev, 0))
 				DRM_ERROR("KGQ disable failed\n");
@@ -7724,6 +7801,16 @@ static uint64_t gfx_v10_0_get_gpu_clock_counter(struct amdgpu_device *adev)
 {
 	uint64_t clock, clock_lo, clock_hi, hi_check;
 
+	if (amdgpu_is_xclipse920(adev)) {
+		/* no SMUIO: RLC's counter, as sgpu does */
+		mutex_lock(&adev->gfx.gpu_clock_mutex);
+		WREG32_SOC15(GC, 0, mmRLC_CAPTURE_GPU_CLOCK_COUNT, 1);
+		clock = (uint64_t)RREG32_SOC15(GC, 0, mmRLC_GPU_CLOCK_COUNT_LSB) |
+			((uint64_t)RREG32_SOC15(GC, 0, mmRLC_GPU_CLOCK_COUNT_MSB) << 32ULL);
+		mutex_unlock(&adev->gfx.gpu_clock_mutex);
+		return clock;
+	}
+
 	switch (amdgpu_ip_version(adev, GC_HWIP, 0)) {
 	case IP_VERSION(10, 1, 3):
 	case IP_VERSION(10, 1, 4):
@@ -7800,6 +7887,10 @@ static void gfx_v10_0_ring_emit_gds_switch(struct amdgpu_ring *ring,
 {
 	struct amdgpu_device *adev = ring->adev;
 
+	/* no GDS/GWS/OA on the Xclipse 920 */
+	if (amdgpu_is_xclipse920(adev))
+		return;
+
 	/* GDS Base */
 	gfx_v10_0_write_data_to_reg(ring, 0, false,
 				    SOC15_REG_OFFSET(GC, 0, mmGDS_VMID0_BASE) + 2 * vmid,
@@ -7851,6 +7942,11 @@ static int gfx_v10_0_early_init(struct amdgpu_ip_block *ip_block)
 
 	adev->gfx.num_compute_rings = min(amdgpu_gfx_get_num_kcq(adev),
 					  AMDGPU_MAX_COMPUTE_RINGS);
+	if (amdgpu_is_xclipse920(adev)) {
+		/* bring-up: one gfx queue, no compute (KCQ PIO map todo) */
+		adev->gfx.num_gfx_rings = 1;
+		adev->gfx.num_compute_rings = 0;
+	}
 
 	gfx_v10_0_set_kiq_pm4_funcs(adev);
 	gfx_v10_0_set_ring_funcs(adev);
@@ -7864,6 +7960,12 @@ static int gfx_v10_0_early_init(struct amdgpu_ip_block *ip_block)
 
 	amdgpu_init_rlc_reg_funcs(adev);
 
+	if (amdgpu_is_xclipse920(adev)) {
+		/* firmware preloaded; WAIT_REG_MEM write+wait works (sgpu) */
+		adev->gfx.cp_fw_write_wait = true;
+		return 0;
+	}
+
 	return gfx_v10_0_init_microcode(adev);
 }
 
@@ -8451,7 +8553,7 @@ static int gfx_v10_0_set_powergating_state(struct amdgpu_ip_block *ip_block,
 	struct amdgpu_device *adev = ip_block->adev;
 	bool enable = (state == AMD_PG_STATE_GATE);
 
-	if (amdgpu_sriov_vf(adev))
+	if (amdgpu_sriov_vf(adev) || amdgpu_is_xclipse920(adev))
 		return 0;
 
 	switch (amdgpu_ip_version(adev, GC_HWIP, 0)) {
@@ -8488,7 +8590,7 @@ static int gfx_v10_0_set_clockgating_state(struct amdgpu_ip_block *ip_block,
 {
 	struct amdgpu_device *adev = ip_block->adev;
 
-	if (amdgpu_sriov_vf(adev))
+	if (amdgpu_sriov_vf(adev) || amdgpu_is_xclipse920(adev))
 		return 0;
 
 	switch (amdgpu_ip_version(adev, GC_HWIP, 0)) {
@@ -8634,6 +8736,9 @@ static void gfx_v10_0_ring_emit_hdp_flush(struct amdgpu_ring *ring)
 	struct amdgpu_device *adev = ring->adev;
 	u32 ref_and_mask, reg_mem_engine;
 
+	if (amdgpu_is_xclipse920(adev))
+		return;
+
 	if (!adev->gfx.funcs->get_hdp_flush_mask) {
 		dev_err(adev->dev, "%s: gfx hdp flush is not supported.\n", __func__);
 		return;
diff --git a/drivers/gpu/drm/amd/amdgpu/gfxhub_v2_1.c b/drivers/gpu/drm/amd/amdgpu/gfxhub_v2_1.c
index 30b90d35a..fb097f88b 100644
--- a/drivers/gpu/drm/amd/amdgpu/gfxhub_v2_1.c
