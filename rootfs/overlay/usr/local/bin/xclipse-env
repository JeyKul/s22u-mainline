#!/bin/sh
# Run a program with the Xclipse 920 Mesa build (/opt/mesa-xc, mesa-patches/xclipse920.diff).
# Mesa finds the Xclipse by itself (PCI subsystem 144d:0920); ACO_XCLIPSE=0/1 overrides.
# Usage: xclipse-env cmd args...
export LD_LIBRARY_PATH=/opt/mesa-xc/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export __EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-xc/share/glvnd/egl_vendor.d/50_mesa.json
export GBM_BACKENDS_PATH=/opt/mesa-xc/lib/gbm
export LIBGL_DRIVERS_PATH=/opt/mesa-xc/lib/dri
export VK_ICD_FILENAMES=/opt/mesa-xc/share/vulkan/icd.d/radeon_icd.aarch64.json
exec "$@"
