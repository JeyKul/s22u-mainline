#!/bin/sh
# Plasma Mobile rendered by the Xclipse 920: KWin drives simpledrm (card0) through GBM,
# which Mesa (kmsro + radeonsi, mesa-patches/xclipse920.diff) backs with GPU buffers.
export KWIN_DRM_DEVICES=$(readlink -f /dev/dri/by-path/platform-chosen:framebuffer-card)
if [ -e /dev/dri/renderD128 ]; then
	exec /usr/local/bin/xclipse-env /usr/lib/plasma-dbus-run-session-if-needed startplasmamobile
fi
exec /usr/lib/plasma-dbus-run-session-if-needed startplasmamobile
