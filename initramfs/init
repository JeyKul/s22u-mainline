#!/bin/busybox sh
# b0s initramfs: shell over USB, and a way back to TWRP at any time.
#   Hold Volume Up for 2 s          -> reboot to TWRP
#   USB serial (ttyACM0 on the PC)  -> root shell
#   USB network 172.16.42.1         -> telnet, no password
#   `twrp` in the shell             -> reboot to TWRP
/bin/busybox --install -s /bin
export PATH=/bin:/sbin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug
mount -t pstore pstore /sys/fs/pstore 2>/dev/null

exec >/dev/tty0 2>&1 </dev/null
log() { echo "[b0s] $*"; echo "[b0s] $*" >/dev/kmsg; }

log "initramfs on $(uname -r), $(grep -c ^processor /proc/cpuinfo) CPUs, $(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo) MiB"
log "hold Volume Up 2 s at any time to reboot to TWRP"

# Vol Up watcher: 2 s held -> TWRP
(
	n=0
	while :; do
		if b0s-volup; then n=$((n + 1)); else n=0; fi
		if [ $n -ge 4 ]; then
			log "Volume Up held: rebooting to TWRP"
			b0s-reboot recovery
		fi
		sleep 0.5
	done
) &

# USB gadget: ACM serial + NCM network
g=/sys/kernel/config/usb_gadget/b0s
gadget_up() {
	mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
	echo 0x18d1 > $g/idVendor
	echo 0xd001 > $g/idProduct
	echo "mainline" > $g/strings/0x409/manufacturer
	echo "Galaxy S22 Ultra (b0s)" > $g/strings/0x409/product
	echo "b0s-mainline" > $g/strings/0x409/serialnumber
	echo "acm+ncm" > $g/configs/c.1/strings/0x409/configuration
	mkdir -p $g/functions/acm.usb0 $g/functions/ncm.usb0
	# fixed MACs: the PC keeps the same usb0 across boots
	echo 02:b0:5e:00:00:01 > $g/functions/ncm.usb0/dev_addr
	echo 02:b0:5e:00:00:02 > $g/functions/ncm.usb0/host_addr
	ln -s $g/functions/acm.usb0 $g/configs/c.1/
	ln -s $g/functions/ncm.usb0 $g/configs/c.1/
	for i in $(seq 1 50); do
		udc=$(ls /sys/class/udc 2>/dev/null | head -n1)
		[ -n "$udc" ] && break
		sleep 0.2
	done
	[ -n "$udc" ] || { log "no UDC: USB gadget unavailable"; return 1; }
	echo "$udc" > $g/UDC && log "USB gadget on $udc"
}

if gadget_up; then
	ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null
	cat > /tmp/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
lease_file /tmp/udhcpd.leases
EOF
	touch /tmp/udhcpd.leases
	udhcpd /tmp/udhcpd.conf
	telnetd -l /bin/sh
	log "telnet 172.16.42.1 (USB network) or screen /dev/ttyACM0"
	( while :; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &
fi

cat > /bin/twrp <<'EOF'
#!/bin/sh
exec b0s-reboot recovery
EOF
chmod +x /bin/twrp

dmesg > /tmp/dmesg.boot

# root: userdata (f2fs) -> switch_root to its init
find_part() {
	for u in /sys/class/block/*/uevent; do
		grep -qx "PARTNAME=$1" "$u" && { echo "/dev/$(basename "$(dirname "$u")")"; return 0; }
	done
	return 1
}
root=""
for i in $(seq 1 50); do
	root=$(find_part userdata) && break
	sleep 0.2
done
mkdir -p /newroot
if grep -qw b0s.shell /proc/cmdline; then
	log "b0s.shell: staying in the initramfs"
elif [ -z "$root" ]; then
	log "userdata not found: staying in the initramfs"
elif ! mount -t f2fs -o rw,noatime "$root" /newroot; then
	log "mounting $root failed: staying in the initramfs"
elif [ ! -x /newroot/sbin/init ] && [ ! -L /newroot/sbin/init ]; then
	log "no /sbin/init on $root: staying in the initramfs"
	umount /newroot
else
	# another system in a directory of userdata: /.b0s-boot-once (one boot, then deleted, so a
	# failed boot falls back) or /.b0s-root (every boot), each holding the directory name
	alt=""
	if [ -f /newroot/.b0s-boot-once ]; then
		alt=$(head -n1 /newroot/.b0s-boot-once); rm -f /newroot/.b0s-boot-once; sync
	elif [ -f /newroot/.b0s-root ]; then
		alt=$(head -n1 /newroot/.b0s-root)
	fi
	case "$alt" in */*|.*) alt="";; esac
	if [ -n "$alt" ] && { [ -x "/newroot/$alt/sbin/init" ] || [ -L "/newroot/$alt/sbin/init" ]; }; then
		log "root: /$alt on $root"
		mkdir -p /altroot && mount --bind "/newroot/$alt" /altroot
		umount -l /newroot
		mount --move /altroot /newroot
	elif [ -n "$alt" ]; then
		log "root: /$alt has no sbin/init ($(ls -l /newroot/$alt/sbin/init 2>&1)): using $root itself"
	fi
	log "switching to $root"
	cp /tmp/dmesg.boot /newroot/var/log/dmesg.initramfs 2>/dev/null
	# hand the USB serial over to the new system's getty
	kill $(jobs -p) 2>/dev/null
	killall getty telnetd udhcpd 2>/dev/null
	for m in /dev /proc /sys /run; do mount --move $m /newroot$m; done
	exec switch_root /newroot /sbin/init </newroot/dev/console >/newroot/dev/console 2>&1
fi
log "ready"

# local console on the screen, for whenever input works
while :; do
	sleep 3600
done
