diff --git a/src/util/u_xclipse.h b/src/util/u_xclipse.h
new file mode 100644
index 0000000..f3e5b68
--- /dev/null
+++ b/src/util/u_xclipse.h
@@ -0,0 +1,67 @@
+/*
+ * Copyright 2026 Mesa contributors
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef U_XCLIPSE_H
+#define U_XCLIPSE_H
+
+#include <dirent.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/*
+ * Samsung Xclipse 920 (Exynos 2200) on mainline amdgpu: its registers are GC 10.3 (it runs
+ * as a Van Gogh, PCI 1002:163f), but the shader ISA and ABI, descriptors and formats are
+ * gfx11's, and VOPD and s_delay_alu hang it. The kernel marks it with the PCI subsystem id
+ * 144d:0920 (Samsung). ACO_XCLIPSE=0/1 overrides the detection.
+ */
+static inline bool
+util_xclipse920_detect(void)
+{
+   const char *e = getenv("ACO_XCLIPSE");
+   bool found = false;
+   DIR *d;
+   struct dirent *de;
+
+   if (e && *e)
+      return strcmp(e, "0") != 0 && strcmp(e, "false") != 0;
+
+   d = opendir("/sys/bus/pci/devices");
+   if (!d)
+      return false;
+   while (!found && (de = readdir(d))) {
+      char path[320];
+      unsigned v[3] = {0};
+      const char *names[3] = {"device", "subsystem_vendor", "subsystem_device"};
+      bool ok = true;
+
+      if (de->d_name[0] == '.')
+         continue;
+      for (int i = 0; i < 3 && ok; i++) {
+         FILE *f;
+
+         snprintf(path, sizeof(path), "/sys/bus/pci/devices/%s/%s", de->d_name, names[i]);
+         f = fopen(path, "r");
+         ok = f && fscanf(f, "%x", &v[i]) == 1;
+         if (f)
+            fclose(f);
+      }
+      found = ok && v[0] == 0x163f && v[1] == 0x144d && v[2] == 0x0920;
+   }
+   closedir(d);
+   return found;
+}
+
+static inline bool
+util_xclipse920(void)
+{
+   static int cached = -1;
+
+   if (cached < 0)
+      cached = util_xclipse920_detect();
+   return cached;
+}
+
+#endif
