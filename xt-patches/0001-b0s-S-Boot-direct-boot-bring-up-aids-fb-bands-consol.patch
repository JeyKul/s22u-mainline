 arch/arm64/kernel/Makefile                    |   1 +
 arch/arm64/kernel/b0s-smc-trace.c             | 134 +++++++++++++
 arch/arm64/kernel/head.S                      |  25 +++
 arch/arm64/kernel/smccc-call.S                |  13 ++
 .../wireless/broadcom/bcmdhd_101_24/Makefile  |   2 +-
 init/main.c                                   | 178 ++++++++++++++++++
 7 files changed, 358 insertions(+), 1 deletion(-)
 create mode 100644 arch/arm64/kernel/b0s-smc-trace.c

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index f7a768fda..cf2ec4351 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2080,6 +2080,12 @@ config ARM64_ACPI_PARKING_PROTOCOL
 	  protocol even if the corresponding data is present in the ACPI
 	  MADT table.
 
+config B0S_DIRECT_DEBUG
+	bool "Galaxy S22 Ultra: S-Boot direct boot bring-up aids"
+	help
+	  Stop S-Boot's watchdog, keep the boot framebuffer updating and
+	  paint progress bands into it.
+
 config CMDLINE
 	string "Default kernel command string"
 	default ""
