diff --git a/arch/arm64/kernel/b0s-smc-trace.c b/arch/arm64/kernel/b0s-smc-trace.c
new file mode 100644
index 000000000..763923d21
--- /dev/null
+++ b/arch/arm64/kernel/b0s-smc-trace.c
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy S22 Ultra direct-boot bring-up: record every SMC/HVC made through
+ * __arm_smccc_{smc,hvc} from the first one on (static buffer, no allocator,
+ * no printk), PSCI excepted (only counted). Dump: cat /proc/b0s_smc
+ */
+#include <linux/arm-smccc.h>
+#include <linux/atomic.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/smp.h>
+#include <asm/sysreg.h>
+
+void __b0s_arm_smccc_smc(unsigned long a0, unsigned long a1, unsigned long a2,
+			 unsigned long a3, unsigned long a4, unsigned long a5,
+			 unsigned long a6, unsigned long a7,
+			 struct arm_smccc_res *res, struct arm_smccc_quirk *quirk);
+void __b0s_arm_smccc_hvc(unsigned long a0, unsigned long a1, unsigned long a2,
+			 unsigned long a3, unsigned long a4, unsigned long a5,
+			 unsigned long a6, unsigned long a7,
+			 struct arm_smccc_res *res, struct arm_smccc_quirk *quirk);
+
+#define B0S_SMC_N	16384
+
+struct b0s_smc_rec {
+	u64 t0, t1;		/* cntvct before/after */
+	unsigned long a[8], r[4];
+	void *caller;
+	u16 cpu;
+	u8 hvc, done;
+};
+
+static struct b0s_smc_rec b0s_smc[B0S_SMC_N];
+static atomic_t b0s_smc_n = ATOMIC_INIT(0);
+static atomic_t b0s_psci_n = ATOMIC_INIT(0);
+
+static bool b0s_is_psci(unsigned long fid)
+{
+	return (fid & 0xbfffff00) == 0x84000000;	/* 0x84000xxx, 0xc4000xxx */
+}
+
+static __always_inline void b0s_call(bool hvc, unsigned long a0, unsigned long a1,
+				     unsigned long a2, unsigned long a3,
+				     unsigned long a4, unsigned long a5,
+				     unsigned long a6, unsigned long a7,
+				     struct arm_smccc_res *res,
+				     struct arm_smccc_quirk *quirk, void *caller)
+{
+	struct b0s_smc_rec *e = NULL;
+	int i;
+
+	if (b0s_is_psci(a0)) {
+		atomic_inc(&b0s_psci_n);
+	} else {
+		i = atomic_inc_return(&b0s_smc_n) - 1;
+		if (i < B0S_SMC_N) {
+			e = &b0s_smc[i];
+			e->a[0] = a0; e->a[1] = a1; e->a[2] = a2; e->a[3] = a3;
+			e->a[4] = a4; e->a[5] = a5; e->a[6] = a6; e->a[7] = a7;
+			e->caller = caller;
+			e->cpu = raw_smp_processor_id();
+			e->hvc = hvc;
+			e->t0 = read_sysreg(cntvct_el0);
+		}
+	}
+	if (hvc)
+		__b0s_arm_smccc_hvc(a0, a1, a2, a3, a4, a5, a6, a7, res, quirk);
+	else
+		__b0s_arm_smccc_smc(a0, a1, a2, a3, a4, a5, a6, a7, res, quirk);
+	if (e) {
+		e->t1 = read_sysreg(cntvct_el0);
+		if (res) {
+			e->r[0] = res->a0; e->r[1] = res->a1;
+			e->r[2] = res->a2; e->r[3] = res->a3;
+		}
+		smp_wmb();
+		e->done = 1;
+	}
+}
+
+void __arm_smccc_smc(unsigned long a0, unsigned long a1, unsigned long a2,
+		     unsigned long a3, unsigned long a4, unsigned long a5,
+		     unsigned long a6, unsigned long a7,
+		     struct arm_smccc_res *res, struct arm_smccc_quirk *quirk)
+{
+	b0s_call(false, a0, a1, a2, a3, a4, a5, a6, a7, res, quirk,
+		 __builtin_return_address(0));
+}
+EXPORT_SYMBOL(__arm_smccc_smc);
+
+void __arm_smccc_hvc(unsigned long a0, unsigned long a1, unsigned long a2,
+		     unsigned long a3, unsigned long a4, unsigned long a5,
+		     unsigned long a6, unsigned long a7,
+		     struct arm_smccc_res *res, struct arm_smccc_quirk *quirk)
+{
+	b0s_call(true, a0, a1, a2, a3, a4, a5, a6, a7, res, quirk,
+		 __builtin_return_address(0));
+}
+EXPORT_SYMBOL(__arm_smccc_hvc);
+
+static int b0s_smc_show(struct seq_file *m, void *v)
+{
+	u64 f = read_sysreg(cntfrq_el0);
+	int n = min(atomic_read(&b0s_smc_n), B0S_SMC_N), i, k;
+
+	seq_printf(m, "# %d calls (%d recorded), %d PSCI skipped, cntfrq %llu\n",
+		   atomic_read(&b0s_smc_n), n, atomic_read(&b0s_psci_n), f);
+	seq_puts(m, "# idx t_us dur_us cpu insn a0..a7 -> r0..r3 caller\n");
+	for (i = 0; i < n; i++) {
+		struct b0s_smc_rec *e = &b0s_smc[i];
+
+		seq_printf(m, "%5d %12llu %8llu %u %s", i, e->t0 * 1000000 / f,
+			   e->done ? (e->t1 - e->t0) * 1000000 / f : 0, e->cpu,
+			   e->hvc ? "hvc" : "smc");
+		for (k = 0; k < 8; k++)
+			seq_printf(m, " %lx", e->a[k]);
+		if (e->done)
+			seq_printf(m, " -> %lx %lx %lx %lx", e->r[0], e->r[1],
+				   e->r[2], e->r[3]);
+		else
+			seq_puts(m, " -> (pending)");
+		seq_printf(m, " %pS\n", e->caller);
+	}
+	return 0;
+}
+
+static int __init b0s_smc_proc(void)
+{
+	proc_create_single("b0s_smc", 0444, NULL, b0s_smc_show);
+	return 0;
+}
+fs_initcall(b0s_smc_proc);
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87aabf2bd..46f70b3cd 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -102,13 +102,37 @@ pe_header:
 	 *  x19/x20    __primary_switch()                       callee preserved temp registers
 	 *  x24        __primary_switch() .. relocate_kernel()  current RELR displacement
 	 */
+#ifdef CONFIG_B0S_DIRECT_DEBUG
+	/* b0s bring-up: paint boot fb lines [300 * n, 300 * (n + 1)), MMU off */
+	.macro	b0s_band, n, color
+	mov_q	x4, (0xf6200000 + \n * 300 * 1440 * 4)
+	mov_q	x6, (1440 * 300)
+	mov_q	x5, \color
+9999:	str	w5, [x4], #4
+	subs	x6, x6, #1
+	b.ne	9999b
+	dsb	sy
+	.endm
+#else
+	.macro	b0s_band, n, color
+	.endm
+#endif
+
 SYM_CODE_START(primary_entry)
 	bl	preserve_boot_args
+#ifdef CONFIG_B0S_DIRECT_DEBUG
+	/* S-Boot's 60 s watchdog stays armed: resets a hang; xtinit pets it */
+	mov_q	x4, 0x19f00030			// DECON0 trigger: fb updates
+	mov	w5, #0x1281
+	str	w5, [x4]
+#endif
+	b0s_band 0, 0xffff0000
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	adrp	x23, __PHYS_OFFSET
 	and	x23, x23, MIN_KIMG_ALIGN - 1	// KASLR offset, defaults to 0
 	bl	set_cpu_boot_mode_flag
 	bl	__create_page_tables
+	b0s_band 1, 0xff00ff00
 	/*
 	 * The following calls CPU setup code, see arch/arm64/mm/proc.S for
 	 * details.
@@ -116,6 +140,7 @@ SYM_CODE_START(primary_entry)
 	 * the TCR will have been set.
 	 */
 	bl	__cpu_setup			// initialise processor
+	b0s_band 2, 0xff0000ff
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
diff --git a/arch/arm64/kernel/smccc-call.S b/arch/arm64/kernel/smccc-call.S
index d62447964..67fe340ea 100644
--- a/arch/arm64/kernel/smccc-call.S
+++ b/arch/arm64/kernel/smccc-call.S
@@ -28,10 +28,17 @@
  *		  unsigned long a6, unsigned long a7, struct arm_smccc_res *res,
  *		  struct arm_smccc_quirk *quirk)
