diff --git a/init/main.c b/init/main.c
index 82c9984e4..b8d0b8925 100644
--- a/init/main.c
+++ b/init/main.c
@@ -113,6 +113,179 @@
 #include <kunit/test.h>
 #endif
 
+#ifdef CONFIG_B0S_DIRECT_DEBUG
+/*
+ * Galaxy S22 Ultra direct-boot bring-up aids. The boot fb (0xf6200000,
+ * 1440x3088 ARGB) is plain RAM in Samsung's DT: b0s_early() reserves it
+ * and draws through the linear map, cleaning to PoC for the DECON.
+ *  - b0s_band(n, color): fill lines [300 n, 300 (n + 1))
+ *  - console "b0sfb": printk text, 8x16 font x2, 90x96 cells, wraps
+ *  - console "b0slog": printk text to 0xffa10000 (log_arrdumpreset),
+ *    previous boot's copy at +256 KiB; header "B0SLOG\0\0", u32 len
+ */
+#include <linux/console.h>
+#include <linux/font.h>
+#include <linux/proc_fs.h>
+#include <asm/cacheflush.h>
+#include <asm/early_ioremap.h>
+
+#define B0S_FB_PA	0xf6200000UL
+#define B0S_W		1440
+#define B0S_H		3088
+#define B0S_COLS	(B0S_W / 16)
+#define B0S_ROWS	(B0S_H / 32)
+#define B0S_LOG_PA	0xffa10000UL
+#define B0S_LOG_SZ	0x40000UL
+
+static u32 *b0s_fb;
+static bool b0s_fbcon_up;
+static unsigned int b0s_col, b0s_row;
+static char __iomem *b0s_log;
+
+static void b0s_fill(u32 *p, size_t n, u32 color)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		p[i] = color;
+	__flush_dcache_area(p, n * 4);
+}
+
+static void b0s_band(unsigned int n, u32 color)
+{
+	if (!b0s_fb || b0s_fbcon_up || n > 9)
+		return;
+	b0s_fill(b0s_fb + n * 300 * B0S_W, 300 * B0S_W, color);
+}
+
+static void b0s_fb_newline(void)
+{
+	b0s_col = 0;
+	if (++b0s_row == B0S_ROWS)
+		b0s_row = 0;
+	b0s_fill(b0s_fb + b0s_row * 32 * B0S_W, 32 * B0S_W, 0xff000000);
+	/* a blank row below the newest line */
+	if (b0s_row + 1 < B0S_ROWS)
+		b0s_fill(b0s_fb + (b0s_row + 1) * 32 * B0S_W, 32 * B0S_W, 0xff000000);
+}
+
+static void b0s_fb_glyph(unsigned char c)
+{
+	const unsigned char *g = (const unsigned char *)font_vga_8x16.data + c * 16;
+	u32 *p = b0s_fb + b0s_row * 32 * B0S_W + b0s_col * 16;
+	unsigned int y, x;
+
+	for (y = 0; y < 32; y++) {
+		for (x = 0; x < 16; x++)
+			p[y * B0S_W + x] = g[y / 2] & (0x80 >> (x / 2)) ?
+					   0xffffffff : 0xff000000;
+		__flush_dcache_area(p + y * B0S_W, 16 * 4);
+	}
+}
+
+static const char * const b0s_keys[] = {
+	"nitr", "ramfs", "rootfs", "npack", "init", "anic", "Kernel command",
+	"verlap", "Freeing", "Memory:", "Machine", "Linux version", "rror",
+	"xt:", "sgpu", "G3D", "erif",
+};
+
+static void b0s_fbcon_write(struct console *con, const char *s, unsigned int n)
+{
+	unsigned int i;
+
+	/* only lines of interest: the screen holds 96 */
+	for (i = 0; i < ARRAY_SIZE(b0s_keys); i++)
+		if (strnstr(s, b0s_keys[i], n))
+			break;
+	if (i == ARRAY_SIZE(b0s_keys))
+		return;
+	for (; n; n--, s++) {
+		if (*s == '\n') {
+			b0s_fb_newline();
+			continue;
+		}
+		if (b0s_col == B0S_COLS)
+			b0s_fb_newline();
+		b0s_fb_glyph(*s);
+		b0s_col++;
+	}
+}
+
+static struct console b0s_fbcon = {
+	.name	= "b0sfb",
+	.write	= b0s_fbcon_write,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME,
+	.index	= -1,
+};
+
+static void b0s_log_write(struct console *con, const char *s, unsigned int n)
+{
+	u32 len = __raw_readl(b0s_log + 8);
+
+	if (len + n > B0S_LOG_SZ - 12)
+		n = B0S_LOG_SZ - 12 - len;
+	memcpy_toio(b0s_log + 12 + len, s, n);
+	__raw_writel(len + n, b0s_log + 8);
+	dsb(sy);
+}
+
+static struct console b0s_log_con = {
+	.name	= "b0slog",
+	.write	= b0s_log_write,
+	.flags	= CON_PRINTBUFFER | CON_ENABLED | CON_ANYTIME,
+	.index	= -1,
+};
+
+/* right after setup_arch: linear map and early_ioremap both work */
+static void __init b0s_early(void)
+{
+	char __iomem *prev;
+
+	memblock_reserve(B0S_FB_PA, B0S_W * B0S_H * 4);
+	b0s_fb = __va(B0S_FB_PA);
+	b0s_band(3, 0xffffff00);
+
+	/* kept mapped for good: one early_ioremap slot */
+	b0s_log = early_ioremap(B0S_LOG_PA, B0S_LOG_SZ);
+	prev = early_ioremap(B0S_LOG_PA + B0S_LOG_SZ, B0S_LOG_SZ);
+	if (b0s_log && prev) {
+		/* no memcmp: unaligned loads fault on Device memory */
+		if (__raw_readl(b0s_log) == 0x4c533042)	/* "B0SL" */
+			memcpy_toio(prev, b0s_log, B0S_LOG_SZ);
+		early_iounmap(prev, B0S_LOG_SZ);
+		memcpy_toio(b0s_log, "B0SLOG\0\0\0\0\0\0", 12);
+		register_console(&b0s_log_con);
+	}
+
+	b0s_fill(b0s_fb, B0S_W * B0S_H, 0xff000000);
+	b0s_fbcon_up = true;
+	register_console(&b0s_fbcon);
+}
+
+/* echo "n 0xaarrggbb" > /proc/b0s_band, or any text: shown on the fb log */
+static ssize_t b0s_band_write(struct file *f, const char __user *ubuf,
+			      size_t count, loff_t *ppos)
+{
+	char buf[64];
+	unsigned int n;
+	u32 color;
+
+	if (count >= sizeof(buf) || copy_from_user(buf, ubuf, count))
+		return -EINVAL;
+	buf[count] = 0;
+	if (sscanf(buf, "%u %x", &n, &color) == 2)
+		pr_info("b0s: band %u %08x\n", n, color);
+	return count;
+}
+
+static const struct proc_ops b0s_band_ops = {
+	.proc_write = b0s_band_write,
+};
+#else
+static inline void b0s_band(unsigned int n, u32 color) { }
+static inline void b0s_early(void) { }
+#endif
+
 static int kernel_init(void *);
 
 extern void init_IRQ(void);
@@ -900,6 +1073,7 @@ asmlinkage __visible void __init __no_sanitize_address start_kernel(void)
 	pr_notice("%s", linux_banner);
 	early_security_init();
 	setup_arch(&command_line);
+	b0s_early();
 	setup_boot_config(command_line);
 	setup_command_line(command_line);
 	setup_nr_cpu_ids();
@@ -1455,6 +1629,10 @@ static int __ref kernel_init(void *unused)
 	do_sysctl_args();
 
 	if (ramdisk_execute_command) {
+#ifdef CONFIG_B0S_DIRECT_DEBUG
+		proc_create("b0s_band", 0200, NULL, &b0s_band_ops);
+		pr_info("b0s: running %s\n", ramdisk_execute_command);
+#endif
 		ret = run_init_process(ramdisk_execute_command);
 		if (!ret) {
 			return 0;
-- 
2.56.0

