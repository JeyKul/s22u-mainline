+SYM_FUNC_END(__b0s_arm_smccc_smc)
+#else
 SYM_FUNC_START(__arm_smccc_smc)
 	SMCCC	smc
 SYM_FUNC_END(__arm_smccc_smc)
 EXPORT_SYMBOL(__arm_smccc_smc)
+#endif
 
 /*
  * void arm_smccc_hvc(unsigned long a0, unsigned long a1, unsigned long a2,
@@ -39,7 +46,13 @@ EXPORT_SYMBOL(__arm_smccc_smc)
  *		  unsigned long a6, unsigned long a7, struct arm_smccc_res *res,
  *		  struct arm_smccc_quirk *quirk)
  */
+#ifdef CONFIG_B0S_DIRECT_DEBUG
+SYM_FUNC_START(__b0s_arm_smccc_hvc)
+	SMCCC	hvc
+SYM_FUNC_END(__b0s_arm_smccc_hvc)
+#else
 SYM_FUNC_START(__arm_smccc_hvc)
 	SMCCC	hvc
 SYM_FUNC_END(__arm_smccc_hvc)
 EXPORT_SYMBOL(__arm_smccc_hvc)
+#endif
diff --git a/drivers/net/wireless/broadcom/bcmdhd_101_24/Makefile b/drivers/net/wireless/broadcom/bcmdhd_101_24/Makefile
index f94e518d5..695c0e878 100755
