# ztOS on the Galaxy S22 Ultra: 1440x3088, ztMETRO at 4 pixels a point. wlroots drives the panel
# through the Exynos 2200 DECON KMS driver; Mesa's kmsro (in /opt/mesa-xc, the Xclipse 920 build)
# renders on the GPU into contiguous KMS buffers.
export ZTMETRO_SCALE=4
for c in /dev/dri/by-path/platform-19f00000.display-controller-card \
	 /dev/dri/by-path/platform-chosen:framebuffer-card; do
	[ -e "$c" ] && { export WLR_DRM_DEVICES=$(readlink -f "$c"); break; }
done
export WLR_RENDERER=gles2
export WLR_NO_HARDWARE_CURSORS=1
export LD_LIBRARY_PATH=/opt/mesa-xc/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
export __EGL_VENDOR_LIBRARY_FILENAMES=/opt/mesa-xc/share/glvnd/egl_vendor.d/50_mesa.json
export GBM_BACKENDS_PATH=/opt/mesa-xc/lib/gbm
export LIBGL_DRIVERS_PATH=/opt/mesa-xc/lib/dri
export VK_ICD_FILENAMES=/opt/mesa-xc/share/vulkan/icd.d/radeon_icd.aarch64.json
